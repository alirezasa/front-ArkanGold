---
// مجله آرکان گلد — همه‌ی صفحه‌های /mag هنگام بازدید روی سرور (SSR) از REST API وردپرس ساخته می‌شوند.
// این route فقط وقتی PUBLIC_WP_API_URL تنظیم شده باشد به سایت اضافه می‌شود (src/mag/integration.mjs).
//   /mag، /mag/page/2           ← فهرست مطالب
//   /mag/category/x[/page/n] و آرشیو برچسب/نویسنده
//   /mag/{آدرس مطلب یا برگه}     ← دقیقاً همان آدرسی که وردپرس ساخته است
//   /mag?s=...                   ← جست‌وجو (noindex)
// کدهای وضعیت: ۴۰۴ برای آدرس ناموجود، ۳۰۱ برای آدرس قدیمی/تغییرکرده، ۵۰۳ اگر وردپرس در دسترس
// نباشد و نسخه‌ی کش‌شده‌ای هم وجود نداشته باشد.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import MagArticle from '../components/mag/MagArticle.astro';
import MagBreadcrumb from '../components/mag/MagBreadcrumb.astro';
import MagCard from '../components/mag/MagCard.astro';
import MagLanding from '../components/mag/MagLanding.astro';
import MagPagination from '../components/mag/MagPagination.astro';
import MagSearch from '../components/mag/MagSearch.astro';
import { MAG_NAME, MAG_PATH, SITE_URL } from '../config/site';
import { withDeadline } from '../lib/cache';
import {
  findRedirect,
  getSite,
  latestPosts,
  magLanding,
  resolveMagRoute,
  searchMag,
  topCategories,
  type MagLanding as Landing,
  type MagRoute,
} from '../lib/magazine';
import { breadcrumbSchema, faNum, magPostSeo, magUrl, magHref, pagedPath, truncate, type Crumb, type MagPost } from '../lib/wp';

export const prerender = false;
// قیمت لحظه‌ای طلا در ویجت‌ها و بنرهای مجله روی سرور در HTML نوشته می‌شود (src/middleware.ts)
Astro.locals.livePrice = true;

// آدرس‌های قدیمی وردپرس که دیگر صفحه نیستند
const rawPath = (Astro.params.path ?? '').split('/').filter(Boolean).join('/');
const legacy: Record<string, string> = { feed: '/mag/rss.xml', 'sitemap_index.xml': '/mag/sitemap.xml' };
if (legacy[rawPath]) return Astro.redirect(legacy[rawPath], 301);
if (/^[a-z_-]+-sitemap\d*\.xml$/.test(rawPath)) return Astro.redirect('/mag/sitemap.xml', 301);
// آدرس قدیمی فایل‌ها وقتی وردپرس در /mag بود: /mag/wp-content/uploads/... ← /wp-content/uploads/...
if (rawPath.startsWith('wp-content/uploads/')) {
  return Astro.redirect(`/${rawPath.split('/').map(encodeURIComponent).join('/')}${Astro.url.search}`, 301);
}

// ریدایرکت‌های ماژول Redirections افزونه‌ی Rank Math (۴۱۰/۴۵۱ هم پشتیبانی می‌شود)
const rmRedirect = rawPath ? await withDeadline(findRedirect(rawPath, Astro.url.search.slice(1)), 1500, null) : null;
if (rmRedirect && 'location' in rmRedirect) return Astro.redirect(rmRedirect.location, rmRedirect.status);

const query = (Astro.url.searchParams.get('s') ?? '').trim();
const isSearch = rawPath === '' && query.length > 0;

let route: MagRoute;
let siteDescription = '';
let cats: { name: string; path: string }[] = [];
let landing: Landing | null = null;
let latest: MagPost[] = [];
try {
  route = isSearch ? await searchMag(query) : await resolveMagRoute(rawPath);
  // داده‌های جانبی اختیاری‌اند: خطای آن‌ها صفحه را خراب نمی‌کند
  if (route.kind === 'home' || route.kind === 'post') {
    [siteDescription, cats] = await Promise.all([
      getSite().then((s) => s.description).catch(() => ''),
      topCategories(12).catch(() => []),
    ]);
  }
  if (route.kind === 'home' && route.page === 1) landing = await magLanding().catch(() => null);
  if (route.kind === 'post') latest = await latestPosts(6).catch(() => []);
} catch (err) {
  console.error(`[mag] /mag/${rawPath}:`, err);
  route = { kind: 'notfound' };
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '120');
}

if (route.kind === 'redirect') return Astro.redirect(magHref(route.path), 301);

const unavailable = Astro.response.status === 503;
if (rmRedirect && !('location' in rmRedirect)) route = { kind: 'notfound' };
if (route.kind === 'notfound' && !unavailable) Astro.response.status = rmRedirect && !('location' in rmRedirect) ? rmRedirect.status : 404;
// صفحه‌ی ۴۰۴ همین فایل نمایش داده شود؛ در غیر این صورت Astro صفحه‌ی 404.html ایستا را از خود سرور
// درخواست می‌کند که برنامه‌ی Node.js فقط /mag را پاسخ می‌دهد و آن درخواست در حلقه می‌افتد
if (route.kind === 'notfound') Astro.response.headers.set('X-Astro-Reroute', 'no');
// کش مرورگر/CDN کوتاه است؛ تازه بودن محتوا را کش سرور و پاک‌سازی بعد از انتشار تضمین می‌کنند
Astro.response.headers.set(
  'Cache-Control',
  route.kind === 'notfound' || route.kind === 'search' ? 'no-store' : 'public, max-age=60, stale-while-revalidate=300'
);

const fa = faNum;
const DEFAULT_DESCRIPTION =
  'مجله آرکان گلد: اخبار و تحلیل بازار طلا، آموزش خرید و فروش طلای آب‌شده و شمش، و راهنمای سرمایه‌گذاری در طلا.';
const magCrumbs: Crumb[] = [
  { name: 'آرکان گلد', href: '/' },
  { name: MAG_NAME, href: MAG_PATH },
];

interface View {
  title: string;
  description: string;
  path: string;
  image?: string;
  imageAlt?: string;
  noindex: boolean;
  ogType: string;
  meta: { property: string; content: string }[];
  schemas: Record<string, unknown>[];
  heading?: string;
  kicker?: string;
  intro?: string;
  avatar?: string;
  crumbs?: Crumb[];
}

let view: View;

if (route.kind === 'post') {
  view = magPostSeo(route.post);
} else if (route.kind === 'home' || route.kind === 'archive') {
  const pageSuffix = route.page > 1 ? ` — صفحه ${fa(route.page)}` : '';
  const path = magHref(pagedPath(route.basePath, route.page));
  const crumbs = [...magCrumbs];
  let title: string;
  let description: string;
  let heading: string;
  let kicker = '';
  let intro = '';
  let avatar: string | undefined;

  if (route.kind === 'home') {
    heading = MAG_NAME;
    intro = siteDescription || DEFAULT_DESCRIPTION;
    title = `${MAG_NAME}: اخبار، آموزش و تحلیل بازار طلا${pageSuffix}`;
    description = intro;
  } else {
    const a = route.archive;
    kicker = a.kind === 'category' ? 'دسته‌بندی' : a.kind === 'tag' ? 'برچسب' : 'نویسنده';
    heading = a.kind === 'tag' ? `#${a.name}` : a.name;
    intro = a.description;
    avatar = a.avatar;
    title = `${a.seo.title || `${kicker} ${a.name} | ${MAG_NAME}`}${pageSuffix}`;
    description = truncate(
      a.seo.description || a.description || `${a.kind === 'author' ? 'مطالب' : 'جدیدترین مطالب'} ${a.name} در ${MAG_NAME}.`,
      160
    );
    crumbs.push({ name: a.name, href: magHref(a.path) });
  }
  if (route.page > 1) crumbs.push({ name: `صفحه ${fa(route.page)}`, href: path });

  view = {
    title,
    description,
    path,
    noindex: route.kind === 'archive' && !!route.archive.seo.noindex,
    ogType: 'website',
    meta: [],
    heading,
    kicker,
    intro,
    avatar,
    crumbs,
    schemas: [
      {
        '@context': 'https://schema.org',
        '@type': route.kind === 'home' ? 'Blog' : 'CollectionPage',
        name: heading,
        description,
        url: new URL(path, SITE_URL).toString(),
        inLanguage: 'fa-IR',
        mainEntity: {
          '@type': 'ItemList',
          itemListElement: route.posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: magUrl(p.path), name: p.title })),
        },
      },
      breadcrumbSchema(crumbs),
    ],
  };
} else if (route.kind === 'search') {
  view = {
    title: `جست‌وجوی «${route.query}» در ${MAG_NAME}`,
    description: `نتایج جست‌وجوی «${route.query}» در مطالب ${MAG_NAME}.`,
    path: MAG_PATH,
    noindex: true,
    ogType: 'website',
    meta: [],
    schemas: [],
    heading: `نتایج جست‌وجو برای «${route.query}»`,
    crumbs: [...magCrumbs, { name: 'جست‌وجو', href: MAG_PATH }],
  };
} else {
  view = {
    title: unavailable ? `${MAG_NAME} موقتاً در دسترس نیست` : 'صفحه پیدا نشد',
    description: 'صفحه‌ی موردنظر در مجله آرکان گلد پیدا نشد.',
    path: magHref(rawPath),
    noindex: true,
    ogType: 'website',
    meta: [],
    schemas: [],
  };
}

const listing = route.kind === 'home' || route.kind === 'archive' ? route : null;
---

<BaseLayout
  title={view.title}
  description={view.description}
  path={view.path}
  image={view.image}
  imageAlt={view.imageAlt}
  noindex={view.noindex}
  ogType={view.ogType}
  meta={view.meta}
  jsonLd={view.schemas}
>
  <link slot="head" rel="alternate" type="application/rss+xml" title={MAG_NAME} href={`${MAG_PATH}/rss.xml`} />

  {route.kind === 'post' && <MagArticle post={route.post} related={route.related} latest={latest} categories={cats} />}

  {route.kind === 'home' && landing && <MagLanding landing={landing} listing={route} intro={view.intro ?? ''} />}

  {((listing && !landing) || route.kind === 'search') && (
    <div class="container-page py-8 sm:py-10">
      {view.crumbs && <MagBreadcrumb crumbs={view.crumbs} />}
      <header class="relative mb-8 overflow-hidden rounded-xl2 bg-cta-gradient p-6 sm:p-8 text-white shadow-glow-brand">
        <span class="absolute -left-16 -top-16 h-56 w-56 rounded-full bg-white/5" aria-hidden="true"></span>
        <span class="absolute left-24 -bottom-20 h-40 w-40 rounded-full bg-gold/10" aria-hidden="true"></span>
        <div class="relative flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div class="flex items-center gap-4">
            {view.avatar && <img src={view.avatar} alt={view.heading} width="72" height="72" class="h-16 w-16 rounded-full object-cover ring-2 ring-white/30" />}
            <div>
              {view.kicker && <p class="mb-1 flex items-center gap-2 text-xs text-white/70"><span class="h-1.5 w-1.5 rounded-full bg-gold"></span>{view.kicker}</p>}
              <h1 class="text-2xl md:text-3xl font-extrabold">
                {view.heading}
                {listing && listing.page > 1 && <span class="text-base font-normal text-white/70"> — صفحه {fa(listing.page)}</span>}
              </h1>
              {view.intro && <p class="mt-2 max-w-2xl text-sm leading-7 text-white/80">{view.intro}</p>}
            </div>
          </div>
          <MagSearch value={route.kind === 'search' ? route.query : ''} />
        </div>
      </header>

      {route.kind === 'search' && route.posts.length === 0 && (
        <p class="rounded-xl2 bg-white py-14 text-center text-sm text-ink-soft shadow-card">مطلبی با این عبارت پیدا نشد. عبارت دیگری را امتحان کنید.</p>
      )}

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {(listing?.posts ?? (route.kind === 'search' ? route.posts : [])).map((p, i) => (
          <MagCard post={p} headingTag="h2" eager={!!listing && listing.page === 1 && i < 4} />
        ))}
      </div>

      {listing && <MagPagination page={listing.page} totalPages={listing.totalPages} basePath={listing.basePath} />}
    </div>
  )}

  {route.kind === 'notfound' && (
    <section class="container-page py-20">
      <div class="mx-auto max-w-xl rounded-xl2 bg-white p-8 sm:p-10 text-center shadow-card">
        <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-50 text-brand"><Icon name={unavailable ? 'clock' : 'search'} class="h-8 w-8" /></span>
        <h1 class="mt-5 text-2xl font-bold text-brand">{unavailable ? 'مجله موقتاً در دسترس نیست' : 'این صفحه پیدا نشد'}</h1>
        <p class="mt-3 text-sm leading-7 text-ink-soft">
          {unavailable ? 'لطفاً چند دقیقه‌ی دیگر دوباره سر بزنید.' : 'ممکن است مطلب حذف شده یا آدرس آن تغییر کرده باشد. در مطالب مجله جست‌وجو کنید:'}
        </p>
        {!unavailable && <MagSearch class="mx-auto mt-6" />}
        <a href={MAG_PATH} class="btn-primary mt-8">بازگشت به مجله</a>
      </div>
    </section>
  )}
</BaseLayout>

