---
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { INSTAGRAM_URL, LIVECHAT_EMBED_URL, OFFICE_ADDRESS_PARTS, SUPPORT_PHONE_INTL } from '../config/site';
import { RETURN_POLICY } from '../lib/merchantPolicy';
import { MIRROR_ENABLED } from '../lib/endpoints';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  ogType?: string;
  imageAlt?: string;
  meta?: { property: string; content: string }[];
  /** JSON-LD اضافی مخصوص همان صفحه (مثلا Product یا FAQPage) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, path, image, noindex, jsonLd, ogType, imageAlt, meta } = Astro.props;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'آرکان گلد | Arkan Gold',
  alternateName: 'Arkan Gold',
  url: 'https://arkan.gold',
  logo: 'https://arkan.gold/images/arkan-gold-logo.png',
  description:
    'خرید و فروش آنلاین طلای آب‌شده و شمش طلای ۷۵۰ عیار با پشتوانه واقعی، فاکتور رسمی و امکان تحویل فیزیکی.',
  telephone: SUPPORT_PHONE_INTL,
  address: { '@type': 'PostalAddress', ...OFFICE_ADDRESS_PARTS },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: SUPPORT_PHONE_INTL,
    contactType: 'customer service',
    areaServed: 'IR',
    availableLanguage: ['fa'],
  },
  sameAs: [INSTAGRAM_URL],
  // سیاست مرجوعی کل فروشگاه (همان RETURN_POLICY صفحه‌ی شمش‌ها): مرجوعی ندارد، فقط فروش مجدد به قیمت روز
  hasMerchantReturnPolicy: RETURN_POLICY,
};

const schemas = [organizationSchema, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#330509" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- نصب به‌صورت اپلیکیشن (PWA / افزودن به صفحه اصلی) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="آرکان گلد" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <Seo title={title} description={description} path={path} image={image} noindex={noindex} ogType={ogType} imageAlt={imageAlt} meta={meta} />
    <Analytics />

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <!-- چت آنلاین (پشتیبانی آنلاین) — دکمه‌ی شناورش مخفی است و از منوها باز می‌شود: src/lib/support.ts.
         روی arkangold.ir از app.arkangold.ir بارگذاری می‌شود (قطعی اینترنت بین‌الملل) -->
    <script is:inline define:vars={{ chatSrc: LIVECHAT_EMBED_URL, mirror: MIRROR_ENABLED }}>
      (function () {
        var h = location.hostname, src = chatSrc;
        if (mirror && (h === 'arkangold.ir' || /\.arkangold\.ir$/.test(h))) src = src.replace('arkan.gold', 'arkangold.ir');
        var s = document.createElement('script');
        s.src = src;
        s.defer = true;
        document.body.appendChild(s);
      })();
    </script>
    <script>
      import '../lib/domainLinks';
    </script>
  </body>
</html>
