---
import Seo from '../components/Seo.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { OFFICE_ADDRESS_PARTS, SUPPORT_PHONE_INTL } from '../config/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  ogType?: string;
  imageAlt?: string;
  meta?: { property: string; content: string }[];
  /** JSON-LD اضافی مخصوص همان صفحه (مثلا Product یا FAQPage) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, path, image, noindex, jsonLd, ogType, imageAlt, meta } = Astro.props;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'آرکان گلد | Arkan Gold Gallery',
  alternateName: 'Arkan Gold',
  url: 'https://arkan.gold',
  logo: 'https://arkan.gold/images/logo.png',
  description:
    'خرید و فروش آنلاین طلای آب‌شده و شمش طلای ۷۵۰ عیار با پشتوانه واقعی، فاکتور رسمی و امکان تحویل فیزیکی.',
  telephone: SUPPORT_PHONE_INTL,
  address: { '@type': 'PostalAddress', ...OFFICE_ADDRESS_PARTS },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: SUPPORT_PHONE_INTL,
    contactType: 'customer service',
    areaServed: 'IR',
    availableLanguage: ['fa'],
  },
  sameAs: [],
};

const schemas = [organizationSchema, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#330509" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <Seo title={title} description={description} path={path} image={image} noindex={noindex} ogType={ogType} imageAlt={imageAlt} meta={meta} />
    <Analytics />

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
