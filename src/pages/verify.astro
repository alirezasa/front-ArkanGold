---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import FaqAccordion from '../components/sections/FaqAccordion.astro';
import { APP_URL, SUPPORT_PHONE, SUPPORT_PHONE_FA } from '../config/site';
import { faqIntro } from '../data/faq';

const steps = [
  { title: 'کد ۸ رقمی را پیدا کنید', desc: 'کد ۸ رقمی اصالت روی هولوگرام اختصاصی کارت پلمپ شمش درج شده است.' },
  { title: 'کد را وارد کنید', desc: 'کد ۸ رقمی را دقیقاً مطابق هولوگرام وارد کنید؛ اعداد فارسی یا انگلیسی هر دو قابل قبول هستند.' },
  { title: 'مشخصات را تطبیق دهید', desc: 'نام محصول، وزن، عیار، ابعاد و نام مالک نمایش‌داده‌شده را با شمش، کارت و فاکتور آن مقایسه کنید.' },
];

const checks = [
  'پلمپ و کارت شمش سالم، بدون خراش، باز شدگی یا چسب‌کاری مجدد باشد.',
  'هولوگرام روی کارت سالم و بدون آسیب باشد و کد ۸ رقمی آن خوانا باشد.',
  'وزن، عیار، ابعاد و کد محصول نمایش‌داده‌شده در استعلام با مشخصات درج‌شده روی کارت یکی باشد.',
  'هنگام خرید دست‌دوم، نام مالک ثبت‌شده در استعلام را با فروشنده تطبیق دهید.',
  'در صورت هرگونه مغایرت، از خرید یا دریافت شمش خودداری کرده و با پشتیبانی تماس بگیرید.',
];

/** فروش شمش به شخص دیگر: انتقال مالکیت در پنل کاربری */
const transferSteps = [
  { who: 'فروشنده', title: 'ورود به پنل کاربری', desc: 'با حساب کاربری خود (همان حسابی که شمش به نام آن ثبت است) وارد پنل آرکان گلد شوید.' },
  { who: 'فروشنده', title: 'ثبت انتقال مالکیت', desc: 'شمش موردنظر را از میان شمش‌های خود انتخاب کرده و با وارد کردن شماره همراه خریدار جدید، درخواست انتقال مالکیت را ثبت کنید.' },
  { who: 'خریدار', title: 'ورود به پنل و تایید انتقال', desc: 'خریدار جدید با همان شماره همراه وارد پنل آرکان گلد می‌شود (در صورت نداشتن حساب، ثبت‌نام و احراز هویت می‌کند) و درخواست انتقال مالکیت را تایید می‌کند.' },
  { who: 'هر دو', title: 'ثبت مالک جدید', desc: 'پس از تایید خریدار، شمش به نام او ثبت می‌شود و از این پس در استعلام اصالت، نام مالک جدید نمایش داده می‌شود.' },
];

/** خرید شمش به‌عنوان هدیه */
const giftSteps = [
  { title: 'انتخاب خرید هدیه', desc: 'هنگام ثبت سفارش خرید شمش در پنل، مشخص کنید که شمش را برای شخص دیگری (به‌عنوان هدیه) خریداری می‌کنید.' },
  { title: 'ثبت شماره همراه هدیه‌گیرنده', desc: 'شماره همراه هدیه‌گیرنده را با دقت وارد کنید. این شماره باید به نام خود هدیه‌گیرنده باشد، چون مالکیت شمش با احراز هویت صاحب همین شماره ثبت می‌شود.' },
  { title: 'تایید توسط هدیه‌گیرنده', desc: 'هدیه‌گیرنده با همان شماره همراه وارد پنل آرکان گلد می‌شود، احراز هویت می‌کند و مالکیت شمش را تایید می‌کند.' },
  { title: 'نمایش نام هدیه‌گیرنده', desc: 'پس از تایید، در استعلام اصالت شمش نام هدیه‌گیرنده به‌عنوان مالک نمایش داده می‌شود.' },
];

const ownershipWarnings = [
  'تا زمانی که انتقال مالکیت در پنل ثبت و توسط خریدار تایید نشده باشد، شمش همچنان به نام فروشنده است.',
  'پیش از پرداخت وجه، کد ۸ رقمی شمش را استعلام کنید و نام مالک نمایش‌داده‌شده را با هویت فروشنده تطبیق دهید.',
  'از فروشنده بخواهید انتقال مالکیت را همزمان با معامله در پنل ثبت کند و شما بلافاصله آن را تایید کنید.',
  'اگر هنگام خرید هدیه شماره همراه خودتان را وارد کنید، شمش به نام شما ثبت می‌شود و برای واگذاری باید بعداً انتقال مالکیت انجام دهید.',
];

const verifyFaq = [
  {
    question: 'کد ۸ رقمی اصالت شمش آرکان گلد کجا درج شده است؟',
    answer: 'کد ۸ رقمی اصالت هر شمش روی هولوگرام اختصاصی کارت پلمپ شمش چاپ شده است. این کد برای هر شمش یکتا است و فقط از طریق سامانه آرکان گلد قابل استعلام است.',
  },
  {
    question: 'اگر نتیجه استعلام «یافت نشد» بود چه کنم؟',
    answer: 'ابتدا کد ۸ رقمی را دوباره و با دقت وارد کنید. اگر باز هم یافت نشد، شمش را خریداری یا دریافت نکنید و موضوع را از طریق تماس تلفنی یا تیکت به پشتیبانی آرکان گلد اطلاع دهید.',
  },
  {
    question: 'چگونه شمش آرکان گلد خود را به شخص دیگری بفروشم؟',
    answer: 'فروشنده باید از طریق پنل کاربری آرکان گلد، با وارد کردن شماره همراه خریدار، درخواست انتقال مالکیت شمش را ثبت کند. خریدار جدید با ورود به پنل (و احراز هویت در صورت نیاز) انتقال را تایید می‌کند و پس از آن شمش به نام او ثبت می‌شود.',
  },
  {
    question: 'شمشی که به‌عنوان هدیه خریداری می‌شود به نام چه کسی ثبت می‌شود؟',
    answer: 'هنگام خرید شمش هدیه باید شماره همراه هدیه‌گیرنده (شماره‌ای که به نام خود او است) ثبت شود. هدیه‌گیرنده با همان شماره وارد پنل شده و مالکیت را تایید می‌کند و از آن پس در استعلام اصالت، نام او به‌عنوان مالک نمایش داده می‌شود.',
  },
  {
    question: 'آیا استعلام اصالت هزینه دارد؟',
    answer: 'خیر، استعلام اصالت شمش در آرکان گلد رایگان و بدون نیاز به ثبت‌نام است و در هر ساعت از شبانه‌روز امکان‌پذیر است.',
  },
  {
    question: 'در نتیجه استعلام چه اطلاعاتی نمایش داده می‌شود؟',
    answer: 'نام محصول، کد محصول، کد GTIN، ابعاد، وزن، عیار، کشور و شرکت سازنده، برند، نام و نام خانوادگی مالک شمش و تاریخ مالکیت او نمایش داده می‌شود.',
  },
  {
    question: 'عیار شمش‌های آرکان گلد چند است؟',
    answer: 'شمش‌های آرکان گلد ۷۵۰ عیار (معادل طلای ۱۸ عیار) هستند و عیار هر شمش در نتیجه استعلام نمایش داده می‌شود.',
  },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'استعلام اصالت شمش آرکان گلد',
  url: 'https://arkan.gold/verify',
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: verifyFaq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title="استعلام اصالت شمش"
  description="استعلام آنلاین و رایگان اصالت شمش طلای آرکان گلد با کد ۸ رقمی هولوگرام؛ مشاهده مشخصات شمش، وزن، عیار، مالک و تاریخ مالکیت."
  path="/verify"
  jsonLd={[pageSchema, faqSchema]}
>
  <section class="relative overflow-hidden py-12 md:py-16">
    <div class="pointer-events-none absolute inset-0 dot-grid-bg opacity-30 [mask-image:radial-gradient(60%_60%_at_50%_0%,black,transparent)]"></div>

    <div class="container-page relative grid gap-10 lg:grid-cols-[1fr_1.1fr] items-start">
      <div class="text-center lg:text-right">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-100/40 bg-white/70 px-3 py-1.5 text-xs font-medium text-brand shadow-sm">
          <Icon name="shield" class="h-4 w-4" />
          رایگان و بدون نیاز به ثبت‌نام
        </span>
        <h1 class="mt-4 text-3xl md:text-4xl font-bold text-brand leading-[1.4]">استعلام اصالت شمش آرکان گلد</h1>
        <p class="mt-4 text-base leading-8 text-ink-soft max-w-xl mx-auto lg:mx-0">
          هر شمش آرکان گلد یک کد ۸ رقمی یکتا روی هولوگرام اختصاصی کارت پلمپ دارد. با وارد کردن این کد،
          اصالت شمش، مشخصات آن و مالک ثبت‌شده‌اش را با اطلاعات سامانه آرکان گلد تطبیق دهید.
        </p>

        <!-- راهنمای محل کد ۸ رقمی -->
        <figure class="mt-8 hidden lg:block">
          <svg viewBox="0 0 420 220" class="w-full max-w-md" role="img" aria-label="محل درج کد ۸ رقمی اصالت روی هولوگرام کارت شمش">
            <defs>
              <linearGradient id="vf-brand" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#5a0d13" /><stop offset="1" stop-color="#1a0204" />
              </linearGradient>
              <linearGradient id="vf-holo" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#c9e7f5" /><stop offset=".35" stop-color="#e8c8f0" /><stop offset=".7" stop-color="#f6e7b0" /><stop offset="1" stop-color="#bfe8d2" />
              </linearGradient>
              <marker id="vf-arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" fill="#330509" />
              </marker>
            </defs>
            <rect x="20" y="16" width="170" height="188" rx="12" fill="url(#vf-brand)" />
            <text x="105" y="46" text-anchor="middle" fill="#e9cf8f" font-size="12" font-weight="700" letter-spacing="2" font-family="Tahoma">ARKAN GOLD</text>
            <rect x="40" y="62" width="130" height="58" rx="6" fill="#ffffff" fill-opacity="0.08" />
            <text x="105" y="88" text-anchor="middle" fill="#ffffff" fill-opacity="0.7" font-size="10" font-family="Tahoma">100 g • 750</text>
            <text x="105" y="106" text-anchor="middle" fill="#ffffff" fill-opacity="0.5" font-size="9" font-family="Tahoma">GOLD BAR</text>
            <rect x="40" y="140" width="130" height="44" rx="22" fill="url(#vf-holo)" stroke="#c5a059" stroke-width="2" stroke-dasharray="5 4" />
            <text x="105" y="168" text-anchor="middle" fill="#330509" font-size="16" font-weight="700" letter-spacing="2" font-family="Tahoma">12345678</text>
            <path d="M178 162 C230 162 240 120 280 120" fill="none" stroke="#330509" stroke-width="2" marker-end="url(#vf-arrow)" />
            <text x="292" y="112" text-anchor="end" fill="#330509" font-size="15" font-weight="700">کد ۸ رقمی اصالت</text>
            <text x="292" y="136" text-anchor="end" fill="#5c5449" font-size="12">روی هولوگرام کارت پلمپ</text>
          </svg>
        </figure>
      </div>

      <!-- فرم استعلام -->
      <div class="rounded-xl2 bg-white border border-brand-100/40 shadow-card-hover p-6 md:p-8">
        <h2 class="text-lg font-bold text-brand mb-1">استعلام با کد ۸ رقمی</h2>
        <p class="text-xs text-ink-soft mb-6">کد ۸ رقمی روی هولوگرام کارت شمش را وارد کنید (مثال: <span class="latin-digits">12345678</span>).</p>

        <form id="verify-form" novalidate class="space-y-4">
          <div>
            <label for="code" class="block mb-1.5 text-sm font-medium text-ink-soft">کد ۸ رقمی اصالت <span class="text-danger">*</span></label>
            <input
              id="code"
              name="code"
              type="text"
              dir="ltr"
              inputmode="numeric"
              autocomplete="off"
              spellcheck="false"
              required
              maxlength="8"
              pattern="[0-9]{8}"
              placeholder="12345678"
              class="latin-digits w-full rounded-lg border border-brand-100/40 px-4 py-3.5 text-2xl font-bold tracking-[0.3em] text-center focus:border-brand focus:outline-none focus:shadow-glow transition-shadow"
              aria-describedby="code-error"
            />
            <p id="code-error" class="hidden mt-1.5 text-xs text-danger" role="alert"></p>
          </div>
          <button id="verify-submit" type="submit" class="btn-primary w-full shine-hover">
            <Icon name="shield" class="h-4.5 w-4.5" />
            <span data-label>استعلام اصالت</span>
          </button>
        </form>

        <!-- نتیجه استعلام -->
        <div id="verify-result" class="mt-6 hidden" aria-live="polite"></div>
      </div>
    </div>
  </section>


  <!-- مهم: انتقال مالکیت هنگام فروش شمش و ثبت شمش هدیه -->
  <section id="ownership" class="container-page py-10 scroll-mt-40">
    <div class="rounded-xl2 border-2 border-gold/50 bg-white shadow-card-hover overflow-hidden">
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 bg-gold-50 px-5 py-5 sm:px-8 border-b border-gold/30">
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand text-white shadow-glow-brand">
          <Icon name="transfer" class="h-6 w-6" />
        </span>
        <div class="min-w-0">
          <p class="inline-flex items-center gap-1.5 rounded-full bg-danger px-2.5 py-0.5 text-[11px] font-bold text-white">مهم</p>
          <h2 class="mt-1.5 text-xl sm:text-2xl font-bold text-brand leading-9">انتقال مالکیت شمش و خرید شمش هدیه</h2>
          <p class="mt-1 text-sm leading-7 text-ink-soft">
            هر شمش آرکان گلد در سامانه به نام یک مالک ثبت می‌شود و نام همین مالک در نتیجه‌ی استعلام اصالت نمایش داده می‌شود.
            بنابراین فروش، واگذاری یا هدیه دادن شمش فقط با ثبت مالکیت در پنل کاربری کامل می‌شود.
          </p>
        </div>
      </div>

      <div class="grid gap-6 p-5 sm:p-8 lg:grid-cols-2">
        <!-- فروش شمش به شخص دیگر -->
        <div class="min-w-0">
          <h3 class="flex items-start gap-2 text-lg font-bold leading-8 text-brand">
            <Icon name="transfer" class="mt-1.5 h-5 w-5 shrink-0 text-gold-500" />
            قصد فروش شمش به شخص دیگری را دارید؟
          </h3>
          <p class="mt-1 text-sm leading-7 text-ink-soft">
            فروشنده باید شمش را از طریق پنل کاربری به خریدار جدید <b class="text-ink">انتقال مالکیت</b> بدهد و خریدار جدید با ورود به پنل، انتقال را <b class="text-ink">تایید</b> کند.
          </p>
          <ol class="mt-4 space-y-3">
            {transferSteps.map((s, i) => (
              <li class="flex items-start gap-3 rounded-card bg-canvas-100 p-3.5">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cta-gradient text-sm font-bold text-white tnum">{(i + 1).toLocaleString('fa-IR')}</span>
                <div class="min-w-0">
                  <p class="text-sm font-bold text-brand">
                    <span class="ml-1 rounded bg-white px-1.5 py-0.5 text-[11px] font-semibold text-ink-soft">{s.who}</span>
                    {s.title}
                  </p>
                  <p class="mt-1 text-xs leading-6 text-ink-soft">{s.desc}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <!-- خرید شمش هدیه -->
        <div class="min-w-0">
          <h3 class="flex items-start gap-2 text-lg font-bold leading-8 text-brand">
            <Icon name="gift" class="mt-1.5 h-5 w-5 shrink-0 text-gold-500" />
            شمش را به‌عنوان هدیه می‌خرید؟
          </h3>
          <p class="mt-1 text-sm leading-7 text-ink-soft">
            هنگام خرید شمش هدیه، <b class="text-ink">شماره همراه هدیه‌گیرنده</b> را ثبت کنید تا شمش از ابتدا به نام او ثبت شود.
          </p>
          <ol class="mt-4 space-y-3">
            {giftSteps.map((s, i) => (
              <li class="flex items-start gap-3 rounded-card bg-canvas-100 p-3.5">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold-500 text-sm font-bold text-white tnum">{(i + 1).toLocaleString('fa-IR')}</span>
                <div class="min-w-0">
                  <p class="text-sm font-bold text-brand">{s.title}</p>
                  <p class="mt-1 text-xs leading-6 text-ink-soft">{s.desc}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="mx-5 mb-5 sm:mx-8 sm:mb-8 rounded-card border border-danger/25 bg-danger-50 p-4">
        <p class="flex items-center gap-2 text-sm font-bold text-danger">
          <Icon name="shield" class="h-4.5 w-4.5" />
          پیش از خرید شمش دست‌دوم حتماً بدانید
        </p>
        <ul class="mt-2 space-y-1.5 text-xs leading-6 text-ink">
          {ownershipWarnings.map((w) => (
            <li class="flex items-start gap-2"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-danger"></span>{w}</li>
          ))}
        </ul>
        <div class="mt-4 flex flex-col sm:flex-row gap-2.5">
          <a href={APP_URL} class="btn-primary !py-3">
            <Icon name="wallet" class="h-4.5 w-4.5" />
            ورود به پنل کاربری
          </a>
          <button type="button" data-support-chat class="btn-outline !py-3 bg-white">
            <Icon name="headset" class="h-4.5 w-4.5" />
            راهنمایی با پشتیبانی آنلاین
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="container-page py-10">
    <h2 class="text-2xl font-bold text-brand text-center mb-8">استعلام در ۳ قدم</h2>
    <ol class="grid gap-5 md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="rounded-xl2 bg-white border border-brand-100/40 shadow-card p-6 card-lift">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-cta-gradient text-white font-bold tnum shadow-glow-brand mb-4">{(i + 1).toLocaleString('fa-IR')}</span>
          <h3 class="font-semibold text-brand text-lg mb-1.5">{s.title}</h3>
          <p class="text-sm leading-7 text-ink-soft">{s.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-page py-10 grid gap-8 lg:grid-cols-2 items-start">
    <div class="rounded-xl2 bg-brand-radial text-white p-7 md:p-9 shadow-glow-brand">
      <h2 class="text-xl font-bold mb-4">نکات مهم هنگام خرید یا دریافت شمش</h2>
      <ul class="space-y-3 text-sm leading-7 text-white/85">
        {checks.map((c) => (
          <li class="flex items-start gap-2.5"><Icon name="shield" class="h-4.5 w-4.5 shrink-0 mt-1 text-gold" /> {c}</li>
        ))}
      </ul>
      <a href={`tel:${SUPPORT_PHONE}`} class="btn-light mt-6">
        <Icon name="headset" class="h-4.5 w-4.5" /> گزارش مغایرت: <span class="tnum">{SUPPORT_PHONE_FA}</span>
      </a>
    </div>

    <div>
      <h2 class="text-xl font-bold text-brand mb-2">سوالات متداول استعلام</h2>
      <p class="text-sm text-ink-soft mb-5">{faqIntro}</p>
      <FaqAccordion items={verifyFaq} idPrefix="verify-faq" />
    </div>
  </section>
</BaseLayout>

<template id="tpl-result">
  <div class="rounded-xl2 border p-5" data-box>
    <div class="flex items-start gap-3">
      <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-white text-xl font-bold" data-badge></span>
      <div class="min-w-0">
        <p class="font-bold text-lg" data-title></p>
        <p class="text-sm leading-7 text-ink-soft" data-text></p>
      </div>
    </div>
    <dl class="mt-4 hidden divide-y divide-brand-100/30 rounded-lg bg-white/80 text-sm" data-details></dl>
  </div>
</template>

<script>
  import { verifyBar, normalizeCode, isValidCode, VERIFY_CODE_LENGTH, type VerifyResult } from '../lib/barVerify';

  const form = document.getElementById('verify-form') as HTMLFormElement;
  const codeInput = document.getElementById('code') as HTMLInputElement;
  const submitBtn = document.getElementById('verify-submit') as HTMLButtonElement;
  const submitLabel = submitBtn.querySelector('[data-label]') as HTMLElement;
  const codeError = document.getElementById('code-error') as HTMLElement;
  const resultEl = document.getElementById('verify-result') as HTMLElement;
  const tpl = document.getElementById('tpl-result') as HTMLTemplateElement;

  function formatDate(value: string): string {
    // تاریخ میلادی ISO به شمسی تبدیل می‌شود؛ تاریخ شمسی همان‌طور نمایش داده می‌شود
    if (/^\d{4}-\d{2}-\d{2}/.test(value) && parseInt(value, 10) > 1700) {
      const d = new Date(value);
      if (!Number.isNaN(d.getTime())) return d.toLocaleDateString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' });
    }
    return value;
  }

  const views: Record<VerifyResult['status'], { tone: 'ok' | 'bad' | 'warn'; title: string; text: string }> = {
    valid: { tone: 'ok', title: 'شمش اصل است', text: 'این کد در سامانه آرکان گلد ثبت شده است. مشخصات زیر را با شمش، کارت و فاکتور آن تطبیق دهید.' },
    not_found: { tone: 'bad', title: 'کد یافت نشد', text: 'شمشی با این کد در سامانه آرکان گلد ثبت نشده است. کد را دوباره بررسی کنید و در صورت تکرار، از خرید یا دریافت شمش خودداری کرده و با پشتیبانی تماس بگیرید.' },
    revoked: { tone: 'bad', title: 'شمش نامعتبر است', text: 'این کد در سامانه به‌عنوان نامعتبر یا مفقودی ثبت شده است. لطفاً فوراً با پشتیبانی آرکان گلد تماس بگیرید.' },
    rate_limited: { tone: 'warn', title: 'تعداد درخواست‌ها زیاد است', text: 'لطفاً چند دقیقه دیگر دوباره تلاش کنید.' },
    error: { tone: 'warn', title: 'استعلام انجام نشد', text: 'ارتباط با سامانه استعلام برقرار نشد. اتصال اینترنت خود را بررسی و دوباره تلاش کنید یا با پشتیبانی تماس بگیرید.' },
  };

  const toneClass = {
    ok: { box: ['border-success/30', 'bg-success-50'], badge: 'bg-success', title: 'text-success', mark: '✓' },
    bad: { box: ['border-danger/30', 'bg-danger-50'], badge: 'bg-danger', title: 'text-danger', mark: '✕' },
    warn: { box: ['border-gold/40', 'bg-gold-50'], badge: 'bg-gold-500', title: 'text-gold-600', mark: '!' },
  };

  /** ردیف‌های نتیجه به ترتیب نمایش؛ مقادیر عددی/لاتین با کلاس latin-digits */
  function detailRows(r: VerifyResult): [string, string, boolean?][] {
    const rows: [string, string | undefined, boolean?][] = [
      ['نام محصول', r.product],
      ['کد محصول', r.productCode, true],
      ['کد GTIN', r.gtin, true],
      ['ابعاد', r.dimensions],
      ['وزن', r.weight],
      ['عیار', r.purity],
      ['کشور سازنده', r.country],
      ['شرکت سازنده', r.manufacturer],
      ['برند', r.brand],
      ['نام و نام خانوادگی مالک', r.ownerName],
      ['تاریخ مالکیت', r.ownedAt ? formatDate(r.ownedAt) : undefined],
      ['کد اصالت', r.code, true],
    ];
    return rows.filter((row): row is [string, string, boolean?] => !!row[1]);
  }

  function renderResult(r: VerifyResult) {
    const view = views[r.status];
    const tone = toneClass[view.tone];
    const node = tpl.content.cloneNode(true) as DocumentFragment;
    const box = node.querySelector('[data-box]') as HTMLElement;
    box.classList.add(...tone.box);
    const badge = node.querySelector('[data-badge]') as HTMLElement;
    badge.classList.add(tone.badge);
    badge.textContent = tone.mark;
    const title = node.querySelector('[data-title]') as HTMLElement;
    title.classList.add(tone.title);
    title.textContent = view.title;
    (node.querySelector('[data-text]') as HTMLElement).textContent = r.message || view.text;

    if (r.status === 'valid') {
      const dl = node.querySelector('[data-details]') as HTMLElement;
      dl.classList.remove('hidden');
      for (const [k, v, latin] of [...detailRows(r), ['زمان استعلام', new Date().toLocaleString('fa-IR')] as [string, string]]) {
        const row = document.createElement('div');
        row.className = 'flex items-start justify-between gap-4 px-4 py-2.5';
        const dt = document.createElement('dt');
        dt.className = 'text-ink-soft shrink-0';
        dt.textContent = k;
        const dd = document.createElement('dd');
        dd.className = 'font-semibold text-ink tnum text-left';
        dd.textContent = v;
        if (latin) dd.classList.add('latin-digits');
        row.append(dt, dd);
        dl.append(row);
      }
    }

    resultEl.replaceChildren(node);
    resultEl.classList.remove('hidden');
    resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function showCodeError(msg: string) {
    codeError.textContent = msg;
    codeError.classList.toggle('hidden', !msg);
    codeInput.classList.toggle('border-danger', !!msg);
    codeInput.setAttribute('aria-invalid', msg ? 'true' : 'false');
  }

  async function run() {
    const code = normalizeCode(codeInput.value);
    codeInput.value = code;
    if (!code) return showCodeError('کد ۸ رقمی را وارد کنید.');
    if (!isValidCode(code)) return showCodeError(`کد اصالت باید دقیقاً ${VERIFY_CODE_LENGTH.toLocaleString('fa-IR')} رقم باشد.`);
    showCodeError('');

    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-70');
    submitLabel.textContent = 'در حال استعلام...';

    const url = new URL(location.href);
    url.searchParams.set('code', code);
    history.replaceState(null, '', url);

    const result = await verifyBar(code);
    renderResult(result);

    submitBtn.disabled = false;
    submitBtn.classList.remove('opacity-70');
    submitLabel.textContent = 'استعلام اصالت';
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    run();
  });
  codeInput.addEventListener('input', () => {
    // فقط عدد (فارسی یا انگلیسی) و حداکثر ۸ رقم
    const clean = normalizeCode(codeInput.value).slice(0, VERIFY_CODE_LENGTH);
    if (codeInput.value !== clean) codeInput.value = clean;
    showCodeError('');
  });

  // لینک مستقیم (مثلا QR روی کارت شمش): /verify?code=12345678
  const preset = new URLSearchParams(location.search).get('code');
  if (preset) {
    codeInput.value = normalizeCode(preset).slice(0, VERIFY_CODE_LENGTH);
    run();
  }
</script>
