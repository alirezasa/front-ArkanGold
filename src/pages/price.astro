---
import BaseLayout from '../layouts/BaseLayout.astro';
import PriceChart from '../components/sections/PriceChart.astro';
---
<BaseLayout
  title="قیمت لحظه‌ای طلا"
  description="مشاهده قیمت لحظه‌ای طلای آب‌شده، شمش و سکه طلا در آرکان گلد؛ بروزرسانی خودکار هر ۳۰ ثانیه."
  path="/price"
>
  <section class="container-page py-14 max-w-2xl mx-auto text-center">
    <p class="text-xs text-brand mb-2">قیمت لحظه‌ای</p>
    <h1 class="text-3xl font-bold text-brand mb-4">قیمت لحظه‌ای طلا</h1>
    <p class="text-base leading-8 text-ink-soft">
      قیمت‌های زیر مستقیماً از بازار دریافت شده و هر ۳۰ ثانیه به‌صورت خودکار بروزرسانی
      می‌شوند.
    </p>

    <div class="mt-10 rounded-card bg-white border border-brand-100/40 shadow-card p-8 text-center max-w-sm mx-auto card-lift">
      <div class="flex items-center justify-center gap-1.5 text-xs text-ink-soft mb-1">
        <span class="live-dot"></span>
        هر گرم طلای ۱۸ عیار
      </div>
      <p class="text-4xl font-extrabold text-brand tnum" data-price-bind="pricePerGram" data-price-format="toman">
        در حال دریافت...
      </p>
      <p class="mt-2 text-sm font-semibold tnum" data-price-bind="changePercent">--</p>
      <p class="mt-3 text-xs text-ink-soft/70">آخرین بروزرسانی: <span data-price-bind="fetchedAt">--</span></p>
    </div>
  </section>

  <PriceChart />
</BaseLayout>

<script>
  import '../lib/priceBinding';
</script>
