---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBadges from '../components/sections/TrustBadges.astro';
import PriceChart from '../components/sections/PriceChart.astro';
import ProductCategories from '../components/sections/ProductCategories.astro';
import Features from '../components/sections/Features.astro';
import Steps from '../components/sections/Steps.astro';
import AboutPanel from '../components/sections/AboutPanel.astro';
import DeliveryMap from '../components/sections/DeliveryMap.astro';
import FaqAccordion from '../components/sections/FaqAccordion.astro';
import CtaBanner from '../components/sections/CtaBanner.astro';
import BlogTeaser from '../components/sections/BlogTeaser.astro';
import VerifyTeaser from '../components/sections/VerifyTeaser.astro';
import { faqItems, faqIntro } from '../data/faq';

const homeFaq = faqItems.slice(0, 7);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title="آرکان گلد | خرید و فروش آنلاین طلای آب‌شده با پشتوانه واقعی"
  description="خرید آنلاین طلای آب‌شده بدون مالیات با امکان تحویل فیزیکی و شمش طلای ۷۵۰ عیار آرکان با فاکتور رسمی و استعلام اصالت. معامله ۲۴ ساعته با کارمزد ۰٫۵ درصد."
  path="/"
  jsonLd={faqSchema}
>
  <Hero />
  <TrustBadges />
  <PriceChart />
  <ProductCategories />
  <VerifyTeaser />
  <Features />
  <Steps />
  <AboutPanel />
  <DeliveryMap />

  <section class="container-page py-14 grid gap-10 lg:grid-cols-[1fr_360px]">
    <div>
      <h2 class="text-2xl font-bold text-brand mb-2">سوالات متداول</h2>
      <p class="text-sm text-ink-soft mb-6">{faqIntro}</p>
      <FaqAccordion items={homeFaq} idPrefix="home-faq" />
    </div>
    <CtaBanner
      eyebrow="پشتیبانی و راهنما"
      title="نیاز به راهنمایی دارید؟"
      description="تیم پشتیبانی آرکان گلد در تمام روزهای هفته از طریق چت آنلاین، تماس تلفنی یا تیکت پاسخگوی شماست."
      ctaLabel="تماس با پشتیبانی"
      ctaHref="/contact"
    />
  </section>

  <BlogTeaser />
</BaseLayout>
