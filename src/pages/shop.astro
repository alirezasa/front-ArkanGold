---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import { loadIngotCatalog } from '../lib/goldIngots';
import { compareIngots, DEFAULT_SORT, ingotDetailPath } from '../lib/ingotCard';

const catalog = await loadIngotCatalog();
const { serviceEnabled } = catalog;
// ترتیب پیش‌فرض: ارزان‌ترین (و در قیمت برابر، سبک‌ترین) اول
const products = [...catalog.products].sort(compareIngots(DEFAULT_SORT));

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://arkan.gold${ingotDetailPath(p.slug)}`,
    name: p.name,
  })),
};
---

<BaseLayout
  title="فروشگاه آرکان گلد | خرید شمش طلا با قیمت لحظه‌ای"
  description="فروشگاه آنلاین آرکان گلد؛ خرید شمش طلای ۱۸ عیار (۷۵۰) آرکان گلد با قیمت لحظه‌ای، فاکتور رسمی، کد ۶ رقمی قابل استعلام اصالت و امکان تحویل فیزیکی."
  path="/shop"
  jsonLd={itemListSchema}
>
  <section class="container-page py-8 sm:py-12">
    <header class="text-center mb-8">
      <p class="text-xs text-brand mb-2">فروشگاه آرکان گلد</p>
      <h1 class="text-2xl md:text-3xl font-bold text-brand">خرید شمش طلا آرکان گلد</h1>
      <p class="mt-2 text-sm text-ink-soft max-w-2xl mx-auto">
        قیمت تمام شمش‌ها به‌صورت لحظه‌ای بر اساس نرخ روز طلای ۱۸ عیار محاسبه می‌شود. همه‌ی شمش‌ها
        دارای فاکتور رسمی، کارت پلمپ امنیتی و کد هولوگرام قابل استعلام اصالت هستند.
      </p>
    </header>

    <!-- نوار قیمت مبنا -->
    <div class="mb-8 grid gap-3 sm:grid-cols-3">
      <div class="rounded-xl2 bg-white border border-brand-100/40 shadow-card px-5 py-4 flex items-center gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand"><Icon name="trend-up" class="h-5 w-5" /></span>
        <div>
          <p class="text-[11px] text-ink-soft flex items-center gap-1.5"><span class="live-dot"></span> هر گرم طلای ۱۸ عیار</p>
          <p class="font-bold text-brand tnum" data-price-bind="pricePerGram" data-price-format="toman">در حال دریافت...</p>
        </div>
      </div>
      <div class="rounded-xl2 bg-white border border-brand-100/40 shadow-card px-5 py-4 flex items-center gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand"><Icon name="gold-bar" class="h-5 w-5" /></span>
        <div>
          <p class="text-[11px] text-ink-soft">قیمت‌گذاری شمش‌ها</p>
          <p class="font-bold text-brand">لحظه‌ای — بروزرسانی <span class="tnum" data-price-bind="fetchedAt">--</span></p>
        </div>
      </div>
      <a href="/verify" class="rounded-xl2 bg-white border border-brand-100/40 shadow-card px-5 py-4 flex items-center gap-3 card-lift">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand text-white"><Icon name="shield" class="h-5 w-5" /></span>
        <div>
          <p class="text-[11px] text-ink-soft">شمش آرکان دارید؟</p>
          <p class="font-bold text-brand">استعلام اصالت با کد ۶ رقمی</p>
        </div>
      </a>
    </div>

    <p id="shop-service-off" class:list={['mb-6 rounded-lg bg-danger-50 px-4 py-3 text-sm text-danger text-center', serviceEnabled && 'hidden']}>
      فروش آنلاین شمش در حال حاضر موقتاً غیرفعال است. لطفاً بعداً مراجعه کنید یا با پشتیبانی تماس بگیرید.
    </p>

    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 sm:mb-8">
      <p class="text-sm text-ink-soft">
        <span id="shop-count" class="tnum font-semibold text-brand">{products.length.toLocaleString('fa-IR')}</span> شمش موجود
      </p>
      <label class="flex items-center gap-2 text-xs text-ink-soft">
        مرتب‌سازی:
        <select id="shop-sort" class="rounded-lg border border-brand-100/40 bg-white px-3 py-2 text-xs text-ink focus:border-brand focus:outline-none">
          <option value="price-asc" selected>ارزان‌ترین</option>
          <option value="price-desc">گران‌ترین</option>
          <option value="weight-asc">سبک‌ترین</option>
          <option value="weight-desc">سنگین‌ترین</option>
        </select>
      </label>
    </div>

    <div id="product-grid" class="grid gap-4 sm:gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {products.map((p) => <ProductCard product={p} serviceEnabled={serviceEnabled} />)}
    </div>

    <p id="shop-loading" class:list={['text-center text-sm text-ink-soft py-16', products.length > 0 && 'hidden']}>
      در حال دریافت محصولات...
    </p>
    <p id="shop-empty" class="hidden text-center text-sm text-ink-soft py-16">در حال حاضر شمش موجودی برای فروش وجود ندارد.</p>
  </section>
</BaseLayout>

<script>
  import '../lib/priceBinding';
  import { watchIngotList } from '../lib/liveIngots';
  import { compareBy, ingotCardHtml, updateIngotCard, DEFAULT_SORT, type IngotSortMode } from '../lib/ingotCard';

  const grid = document.getElementById('product-grid')!;
  const sortSelect = document.getElementById('shop-sort') as HTMLSelectElement;
  const loading = document.getElementById('shop-loading');
  const empty = document.getElementById('shop-empty');
  const countEl = document.getElementById('shop-count');
  const serviceOff = document.getElementById('shop-service-off');

  const cards = () => Array.from(grid.querySelectorAll<HTMLElement>('.product-card'));
  // صفحه‌ی جزئیات ایستا فقط برای شمش‌هایی که در build وجود داشتند ساخته شده است
  const prebuilt = new Set(cards().map((c) => c.dataset.slug));

  // بازگرداندن مرورگر به گزینه‌ی پیش‌فرض (برخی مرورگرها انتخاب قبلی فرم را نگه می‌دارند)
  if (!sortSelect.value) sortSelect.value = DEFAULT_SORT;

  function applySort() {
    const cmp = compareBy((sortSelect.value || DEFAULT_SORT) as IngotSortMode);
    const keyOf = (el: HTMLElement) => ({
      price: parseFloat(el.dataset.price || '') || 0,
      weight: parseFloat(el.dataset.weight || '') || 0,
      inStock: el.dataset.inStock !== 'false',
    });
    cards()
      .sort((a, b) => cmp(keyOf(a), keyOf(b)))
      .forEach((c) => grid.appendChild(c));
  }

  watchIngotList(
    ({ products, serviceEnabled }) => {
      const bySlug = new Map(products.map((p) => [p.slug, p]));

      for (const card of cards()) updateIngotCard(card, bySlug.get(card.dataset.slug!) ?? null, serviceEnabled);

      // شمش‌هایی که بعد از آخرین build اضافه شده‌اند
      const existing = new Set(cards().map((c) => c.dataset.slug));
      for (const p of products) {
        if (existing.has(p.slug)) continue;
        const tpl = document.createElement('template');
        tpl.innerHTML = ingotCardHtml(p, { hasPage: prebuilt.has(p.slug), serviceEnabled });
        grid.appendChild(tpl.content.firstElementChild as HTMLElement);
      }

      const available = cards().filter((c) => bySlug.has(c.dataset.slug!)).length;
      if (countEl) countEl.textContent = available.toLocaleString('fa-IR');
      serviceOff?.classList.toggle('hidden', serviceEnabled);
      loading?.classList.add('hidden');
      empty?.classList.toggle('hidden', cards().length > 0);
      applySort();
    },
    () => {
      if (!cards().length && loading) loading.textContent = 'دریافت محصولات انجام نشد. لطفاً صفحه را دوباره بارگذاری کنید.';
    }
  );

  sortSelect.addEventListener('change', applySort);
  applySort();
</script>
