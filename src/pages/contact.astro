---
import BaseLayout from '../layouts/BaseLayout.astro';
import { OFFICE_ADDRESS, SUPPORT_PHONE, SUPPORT_PHONE_FA } from '../config/site';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'تماس با آرکان گلد',
  url: 'https://arkan.gold/contact',
};

const details = [
  { label: 'تلفن تماس', value: SUPPORT_PHONE_FA, href: `tel:${SUPPORT_PHONE}` },
  { label: 'ایمیل', value: 'info@arkan.gold', href: 'mailto:info@arkan.gold' },
  { label: 'ساعت کاری', value: 'شنبه تا پنج‌شنبه، ۱۰ الی ۱۴ و ۱۶ الی ۲۲' },
  { label: 'آدرس دفتر مرکزی', value: OFFICE_ADDRESS },
];
---

<BaseLayout
  title="تماس با ما"
  description="راه‌های ارتباطی با تیم پشتیبانی آرکان گلد؛ تماس تلفنی، ایمیل و فرم ارتباط با ما."
  path="/contact"
  jsonLd={contactSchema}
>
  <section class="container-page py-12 grid gap-10 lg:grid-cols-2">
    <div>
      <p class="text-xs text-brand mb-2">تماس با ما</p>
      <h1 class="text-2xl md:text-3xl font-bold text-brand mb-4">در ارتباط با آرکان گلد باشید</h1>
      <p class="text-sm leading-8 text-ink-soft mb-8">
        سوالی درباره خرید، فروش یا تحویل فیزیکی طلا دارید؟ تیم پشتیبانی ما آماده پاسخ‌گویی
        است.
      </p>

      <dl class="space-y-4">
        {details.map((d) => (
          <div class="flex flex-col gap-1.5 sm:flex-row sm:items-center sm:justify-between sm:gap-6 rounded-card bg-white border border-brand-100/40 px-5 py-4 shadow-card card-lift">
            <dt class="shrink-0 text-xs text-ink-soft">{d.label}</dt>
            <dd class="min-w-0 text-sm font-semibold leading-7 text-brand tnum sm:text-left">
              {d.href ? <a href={d.href} class="hover:text-brand">{d.value}</a> : d.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <form class="rounded-card bg-white border border-brand-100/40 shadow-card p-6 md:p-8 space-y-4" id="contact-form">
      <div>
        <label for="name" class="block text-xs font-medium text-ink-soft mb-1.5">نام و نام خانوادگی</label>
        <input id="name" name="name" type="text" required class="w-full rounded-lg border border-brand-100/40 px-4 py-2.5 text-sm focus:border-brand focus:outline-none focus:shadow-glow transition-shadow" />
      </div>
      <div>
        <label for="phone" class="block text-xs font-medium text-ink-soft mb-1.5">شماره موبایل</label>
        <input id="phone" name="phone" type="tel" required class="w-full rounded-lg border border-brand-100/40 px-4 py-2.5 text-sm tnum focus:border-brand focus:outline-none focus:shadow-glow transition-shadow" />
      </div>
      <div>
        <label for="message" class="block text-xs font-medium text-ink-soft mb-1.5">پیام شما</label>
        <textarea id="message" name="message" rows="4" required class="w-full rounded-lg border border-brand-100/40 px-4 py-2.5 text-sm focus:border-brand focus:outline-none focus:shadow-glow transition-shadow"></textarea>
      </div>
      <button type="submit" class="btn-primary w-full">
        ارسال پیام
      </button>
      <p id="contact-status" class="text-xs text-ink-soft text-center" role="status"></p>
    </form>
  </section>
</BaseLayout>

<script>
  // این فرم فعلاً فقط سمت کلاینت است. برای فعال‌سازی واقعی، این fetch را
  // به یک endpoint واقعی (مثلا /api/contact یا سرویس ایمیل) وصل کنید.
  const form = document.getElementById('contact-form');
  const status = document.getElementById('contact-status');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (status) status.textContent = 'پیام شما ثبت شد. به‌زودی با شما تماس می‌گیریم.';
    (form as HTMLFormElement).reset();
  });
</script>
