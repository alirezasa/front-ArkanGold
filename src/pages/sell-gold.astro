---
import BaseLayout from '../layouts/BaseLayout.astro';
import GoldCalculator from '../components/sections/GoldCalculator.astro';

const points = [
  'فروش طلای آب‌شده یا شمش با نرخ لحظه‌ای، بدون کسر اجرت',
  'واریز مبلغ به حساب بانکی طی حداکثر ۲۴ ساعت کاری',
  'امکان فروش بخشی از موجودی طلای خزانه‌شده',
  'استعلام رایگان و بدون تعهد قبل از فروش',
];
---

<BaseLayout
  title="فروش طلای آب‌شده و شمش طلا"
  description="فروش آنلاین طلای آب‌شده و شمش طلا با قیمت لحظه‌ای بازار و واریز سریع وجه به حساب بانکی."
  path="/sell-gold"
>
  <section class="container-page py-12 grid gap-10 md:grid-cols-2 items-start">
    <div class="text-center md:text-right order-2 md:order-1">
      <p class="text-xs text-gold mb-2">فروش طلا</p>
      <h1 class="text-2xl md:text-3xl font-bold text-maroon mb-4">
        طلای خود را با بهترین نرخ بفروشید
      </h1>
      <p class="text-sm leading-8 text-ink-soft mb-6">
        طلای آب‌شده یا شمش موجود در حساب خود را با قیمت لحظه‌ای به فروش برسانید و مبلغ آن
        را سریع در حساب بانکی خود دریافت کنید.
      </p>
      <ul class="space-y-3 text-sm text-ink-soft max-w-md mx-auto md:mx-0">
        {points.map((p) => (
          <li class="flex items-center gap-2 justify-center md:justify-start">
            <span class="h-1.5 w-1.5 rounded-full bg-gold shrink-0"></span>
            {p}
          </li>
        ))}
      </ul>
    </div>

    <div class="order-1 md:order-2">
      <GoldCalculator mode="sell" />
    </div>
  </section>
</BaseLayout>
