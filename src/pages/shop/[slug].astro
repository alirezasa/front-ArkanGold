---
// صفحه‌ی اختصاصی هر شمش — در build برای همه‌ی شمش‌های API ساخته می‌شود (سئو).
// HTML از ingotDetailHtml و متادیتا/schema از ingotSeo می‌آید (src/lib/ingotDetail.ts).
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { loadIngotCatalog, type GoldIngot } from '../../lib/goldIngots';
import { ingotDetailHtml, ingotSeo } from '../../lib/ingotDetail';
import { compareIngots } from '../../lib/ingotCard';

export async function getStaticPaths() {
  const { products, serviceEnabled } = await loadIngotCatalog();
  const sorted = [...products].sort(compareIngots('price-asc'));
  return products.map((p) => ({
    params: { slug: p.slug },
    props: {
      product: p,
      serviceEnabled,
      // شمش‌های مشابه: اول هم‌دسته‌ها، بعد بقیه — به ترتیب قیمت
      related: [
        ...sorted.filter((r) => r.id !== p.id && r.category?.slug === p.category?.slug),
        ...sorted.filter((r) => r.id !== p.id && r.category?.slug !== p.category?.slug),
      ].slice(0, 4),
    },
  }));
}

interface Props {
  product: GoldIngot;
  serviceEnabled: boolean;
  related: GoldIngot[];
}
const { product, serviceEnabled, related } = Astro.props;
const seo = ingotSeo(product, serviceEnabled);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path={seo.path}
  image={seo.image}
  imageAlt={seo.imageAlt}
  ogType="product"
  meta={seo.meta}
  jsonLd={seo.schemas}
>
  <Fragment set:html={ingotDetailHtml(product, { serviceEnabled })} />

  {related.length > 0 && (
    <section class="container-page py-10">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-brand">شمش‌های مشابه</h2>
        <a href="/shop" class="text-sm text-brand hover:underline">مشاهده همه</a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {related.map((r) => <ProductCard product={r} serviceEnabled={serviceEnabled} headingLevel="h3" />)}
      </div>
    </section>
  )}

  <div id="ingot-meta" hidden data-slug={product.slug} data-service-enabled={serviceEnabled ? 'true' : 'false'}></div>
</BaseLayout>

<script>
  import { initIngotDetail } from '../../lib/ingotDetailClient';
  import { updateIngotCard } from '../../lib/ingotCard';
  import { watchIngotList } from '../../lib/liveIngots';

  const meta = document.getElementById('ingot-meta')!;
  initIngotDetail({ slug: meta.dataset.slug!, serviceEnabled: meta.dataset.serviceEnabled === 'true' });

  // کارت‌های «شمش‌های مشابه» هم لحظه‌ای می‌شوند
  const relatedCards = Array.from(document.querySelectorAll<HTMLElement>('.product-card'));
  if (relatedCards.length) {
    watchIngotList(({ products, serviceEnabled }) => {
      const bySlug = new Map(products.map((p) => [p.slug, p]));
      relatedCards.forEach((c) => updateIngotCard(c, bySlug.get(c.dataset.slug!) ?? null, serviceEnabled));
    });
  }
</script>
