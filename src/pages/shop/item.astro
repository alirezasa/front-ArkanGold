---
// آدرس قدیمی /shop/item?slug=... (پیش از ساخت صفحه‌ها روی سرور) ← ۳۰۱ به /shop/{slug}
import { ingotDetailPath } from '../../lib/ingotCard';

export const prerender = false;

const slug = (Astro.url.searchParams.get('slug') ?? '').trim();
const variant = Astro.url.searchParams.get('variant');
const target = slug ? `${ingotDetailPath(slug)}${variant ? `?variant=${encodeURIComponent(variant)}` : ''}` : '/shop';
return Astro.redirect(target, 301);
---
