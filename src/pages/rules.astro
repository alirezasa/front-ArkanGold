---
import BaseLayout from '../layouts/BaseLayout.astro';
import { rulesSections, rulesLastUpdated } from '../data/rules';

const rulesSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'قوانین و مقررات آرکان گلد',
  url: 'https://arkan.gold/rules',
};
---

<BaseLayout
  title="قوانین و مقررات"
  description="متن کامل قوانین و مقررات استفاده از خدمات آرکان گلد؛ حساب کاربری، کارمزدها، تحویل فیزیکی طلا، امنیت اطلاعات و حل اختلاف."
  path="/rules"
  jsonLd={rulesSchema}
>
  <!-- هدر صفحه -->
  <section class="bg-brand-radial text-white py-10 md:py-14">
    <div class="container-page">
      <nav aria-label="مسیر صفحه" class="text-xs text-white/60 mb-3 flex items-center gap-1.5">
        <a href="/" class="hover:text-gold transition-colors">خانه</a>
        <span>/</span>
        <span class="text-white/85">قوانین و مقررات</span>
      </nav>
      <h1 class="text-2xl md:text-3xl font-bold">قوانین و مقررات</h1>
      <p class="mt-3 text-sm leading-7 text-white/75 max-w-2xl">
        توجه: استفاده از خدمات پلتفرم آرکان گلد به معنای مطالعه، پذیرش و تعهد کامل به تمامی
        مفاد این سند است.
      </p>
      <p class="mt-2 text-xs text-white/70">آخرین بروزرسانی: {rulesLastUpdated}</p>
    </div>
  </section>

  <section class="container-page py-10 md:py-14">
    <div class="grid gap-8 lg:grid-cols-[1fr_300px] items-start">
      <!-- محتوای اصلی -->
      <div class="space-y-10 order-2 lg:order-1 min-w-0">
        {rulesSections.map((section) => (
          <article id={section.id} class="scroll-mt-28 rounded-card bg-white border border-brand-100/40 shadow-card p-6 md:p-8">
            <div class="flex items-start gap-4 mb-5">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-cta-gradient text-sm font-bold text-white tnum shadow-glow-brand">
                {section.number}
              </span>
              <h2 class="text-lg md:text-xl font-bold text-brand pt-1">{section.title}</h2>
            </div>
            <div class="space-y-4">
              {section.paragraphs.map((p) => (
                <p class="text-sm leading-8 text-ink-soft">{p}</p>
              ))}
            </div>
          </article>
        ))}
      </div>

      <!-- فهرست موضوعات چسبان -->
      <aside class="order-1 lg:order-2 lg:sticky lg:top-24">
        <div class="rounded-card bg-brand p-5 shadow-glow-brand max-h-[75vh] overflow-y-auto scrollbar-thin">
          <p class="text-xs font-bold text-white/70 mb-3">فهرست موضوعات</p>
          <ul class="space-y-1">
            {rulesSections.map((section) => (
              <li>
                <a
                  href={`#${section.id}`}
                  data-toc-link={section.id}
                  class="toc-link flex items-center gap-2 rounded-lg px-3 py-2 text-xs font-medium text-white/80 hover:bg-white/10 transition-colors"
                >
                  <span class="tnum shrink-0">{section.number}.</span>
                  <span class="leading-5">{section.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .toc-link[data-active="true"] {
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    font-weight: 700;
  }
</style>

<script>
  // اسکرول نرم به بخش مربوطه با کلیک روی فهرست
  document.querySelectorAll<HTMLAnchorElement>('.toc-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      const id = link.getAttribute('href')?.slice(1);
      const target = id ? document.getElementById(id) : null;
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.pushState(null, '', `#${id}`);
      }
    });
  });

  // هایلایت خودکار آیتم فعال فهرست بر اساس بخش قابل مشاهده در صفحه
  const sections = document.querySelectorAll<HTMLElement>('article[id]');
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          tocLinks.forEach((link) => {
            link.setAttribute('data-active', String(link.dataset.tocLink === id));
          });
        }
      });
    },
    { rootMargin: '-20% 0px -70% 0px', threshold: 0 }
  );

  sections.forEach((section) => observer.observe(section));
</script>
