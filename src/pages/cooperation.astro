---
import BaseLayout from '../layouts/BaseLayout.astro';
import SimplePage from '../components/sections/SimplePage.astro';
---
<BaseLayout
  title="همکاری در فروش"
  description="فرصت همکاری در فروش با آرکان گلد برای کسب‌وکارها و فروشندگان طلا."
  path="/cooperation"
>
  <SimplePage
    eyebrow="همکاری در فروش"
    title="با آرکان گلد همکاری کنید"
    intro="اگر فروشنده طلا هستید یا مایل به همکاری تجاری با آرکان گلد هستید، از طریق فرم تماس با ما در ارتباط باشید."
  >
    <a href="/contact" class="inline-block rounded-lg bg-maroon px-7 py-3 text-sm font-semibold text-cream-50 hover:bg-maroon-400 transition-colors">
      ارسال درخواست همکاری
    </a>
  </SimplePage>
</BaseLayout>
