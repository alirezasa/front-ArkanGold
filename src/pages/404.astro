---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="صفحه پیدا نشد"
  description="صفحه مورد نظر یافت نشد."
  path="/404"
  noindex={true}
>
  <section class="container-page py-24 text-center">
    <p class="text-6xl font-extrabold text-brand mb-4 tnum">۴۰۴</p>
    <h1 class="text-xl font-bold text-brand mb-3">صفحه مورد نظر پیدا نشد</h1>
    <p class="text-sm text-ink-soft mb-8">ممکن است لینک اشتباه باشد یا صفحه جابه‌جا شده باشد.</p>
    <a href="/" class="btn-primary">
      بازگشت به صفحه اصلی
    </a>
  </section>
</BaseLayout>

<script>
  // لینک شمشی که بعد از آخرین build اضافه شده (/shop/{slug}) هنوز صفحه‌ی ایستا ندارد؛
  // کاربر به صفحه‌ی جزئیاتی که در مرورگر از API ساخته می‌شود منتقل می‌شود.
  const match = location.pathname.match(/^\/shop\/([^/]+)\/?$/);
  if (match && match[1] !== 'item') {
    const params = new URLSearchParams(location.search);
    params.set('slug', decodeURIComponent(match[1]));
    location.replace(`/shop/item?${params}`);
  }
</script>
