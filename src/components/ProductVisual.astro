---
// تصویر برداری محصول — وقتی محصول در فروشگاه عکس ندارد، یک طرح SVG از
// شمش / بسته‌بندی هدیه / کارت هدیه سازمانی با وزن محصول رسم می‌شود.
import type { ProductVisual } from '../data/products';

interface Props {
  visual: ProductVisual;
  weightGram: number | null;
  purity?: number;
  class?: string;
  title?: string;
}

const { visual, weightGram, purity = 750, class: className = '', title } = Astro.props;
const uid = `pv${Math.random().toString(36).slice(2, 8)}`;
const weightLabel = weightGram ? `${weightGram.toLocaleString('fa-IR')} گرم` : '';
const purityLabel = purity.toLocaleString('fa-IR');
---

<svg
  viewBox="0 0 400 300"
  preserveAspectRatio="xMidYMid slice"
  class={className}
  role="img"
  aria-label={title ?? `طرح ${weightLabel} آرکان گلد`}
  xmlns="http://www.w3.org/2000/svg"
  style="direction: ltr"
>
  <defs>
    <linearGradient id={`${uid}-gold`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f7e3a8" />
      <stop offset="0.35" stop-color="#d9b25f" />
      <stop offset="0.7" stop-color="#b98a35" />
      <stop offset="1" stop-color="#8a6424" />
    </linearGradient>
    <linearGradient id={`${uid}-goldTop`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff3cf" />
      <stop offset="1" stop-color="#d7ad58" />
    </linearGradient>
    <linearGradient id={`${uid}-brand`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5a0d13" />
      <stop offset="0.6" stop-color="#330509" />
      <stop offset="1" stop-color="#1a0204" />
    </linearGradient>
    <radialGradient id={`${uid}-bg`} cx="0.5" cy="0.45" r="0.7">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#ecebee" />
    </radialGradient>
  </defs>

  <rect width="400" height="300" fill={`url(#${uid}-bg)`} />
  <ellipse cx="200" cy="262" rx="130" ry="12" fill="#330509" opacity="0.10" />

  {visual === 'bar' && (
    <g>
      <!-- کارت پلمپ -->
      <rect x="120" y="28" width="160" height="228" rx="14" fill={`url(#${uid}-brand)`} />
      <rect x="128" y="36" width="144" height="212" rx="10" fill="none" stroke="#c5a059" stroke-opacity="0.55" />
      <text x="200" y="64" text-anchor="middle" fill="#e9cf8f" font-size="15" font-weight="700" letter-spacing="3" font-family="Tahoma, sans-serif">ARKAN GOLD</text>
      <!-- شمش -->
      <rect x="152" y="84" width="96" height="120" rx="8" fill={`url(#${uid}-gold)`} />
      <rect x="160" y="92" width="80" height="104" rx="5" fill="none" stroke="#fff6da" stroke-opacity="0.6" />
      <text x="200" y="134" text-anchor="middle" fill="#6b4a14" font-size="14" font-weight="700" direction="rtl">{weightLabel}</text>
      <text x="200" y="158" text-anchor="middle" fill="#6b4a14" font-size="12" font-family="Tahoma, sans-serif" letter-spacing="1">FINE GOLD</text>
      <text x="200" y="182" text-anchor="middle" fill="#6b4a14" font-size="16" font-weight="800">{purityLabel}</text>
      <path d="M158 90 L178 90 L160 150 Z" fill="#ffffff" opacity="0.25" />
      <text x="200" y="232" text-anchor="middle" fill="#ffffff" fill-opacity="0.75" font-size="11" font-family="Tahoma, sans-serif" letter-spacing="1">SERIAL • VERIFIED</text>
    </g>
  )}

  {visual === 'gift' && (
    <g>
      <!-- جعبه هدیه -->
      <rect x="92" y="110" width="216" height="140" rx="12" fill={`url(#${uid}-brand)`} />
      <rect x="84" y="90" width="232" height="36" rx="8" fill="#4d0a0f" />
      <rect x="188" y="90" width="24" height="160" fill={`url(#${uid}-gold)`} />
      <path d="M200 90 C170 50 130 60 150 88 Z" fill={`url(#${uid}-gold)`} />
      <path d="M200 90 C230 50 270 60 250 88 Z" fill={`url(#${uid}-gold)`} />
      <circle cx="200" cy="90" r="9" fill={`url(#${uid}-goldTop)`} />
      <!-- شمش کوچک جلوی جعبه -->
      <g transform="translate(236 170) rotate(-12)">
        <rect x="-36" y="-26" width="72" height="52" rx="6" fill={`url(#${uid}-gold)`} stroke="#8a6424" stroke-width="1" />
        <text x="0" y="-2" text-anchor="middle" fill="#6b4a14" font-size="11" font-weight="700" direction="rtl">{weightLabel}</text>
        <text x="0" y="16" text-anchor="middle" fill="#6b4a14" font-size="11" font-weight="800">{purityLabel}</text>
      </g>
      <text x="140" y="200" text-anchor="middle" fill="#e9cf8f" font-size="13" font-weight="700" letter-spacing="2" font-family="Tahoma, sans-serif">ARKAN</text>
    </g>
  )}

  {visual === 'card' && (
    <g>
      <g transform="rotate(-6 200 150)">
        <rect x="70" y="70" width="260" height="160" rx="16" fill={`url(#${uid}-brand)`} />
        <path d="M70 180 C150 140 250 220 330 170 L330 214 a16 16 0 0 1 -16 16 H86 a16 16 0 0 1 -16 -16 Z" fill="#ffffff" opacity="0.05" />
        <text x="96" y="104" fill="#e9cf8f" font-size="14" font-weight="700" letter-spacing="3" font-family="Tahoma, sans-serif">ARKAN GOLD</text>
        <text x="96" y="124" fill="#ffffff" fill-opacity="0.6" font-size="9" letter-spacing="1" font-family="Tahoma, sans-serif">CORPORATE GIFT CARD</text>
        <!-- شمش به‌جای چیپ کارت -->
        <rect x="236" y="92" width="70" height="50" rx="6" fill={`url(#${uid}-gold)`} />
        <text x="271" y="114" text-anchor="middle" fill="#6b4a14" font-size="10" font-weight="700" direction="rtl">{weightLabel}</text>
        <text x="271" y="131" text-anchor="middle" fill="#6b4a14" font-size="11" font-weight="800">{purityLabel}</text>
        <text x="96" y="206" fill="#ffffff" fill-opacity="0.85" font-size="14" letter-spacing="4" font-family="Tahoma, sans-serif">•••• •••• •••• 750</text>
      </g>
    </g>
  )}
</svg>
