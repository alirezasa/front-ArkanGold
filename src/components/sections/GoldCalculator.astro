---
import Icon from '../Icon.astro';
import { APP_URL, TRADE_FEE_LABEL } from '../../config/site';

interface Props {
  mode: 'buy' | 'sell';
}
const { mode } = Astro.props;
const label = mode === 'buy' ? 'خرید' : 'فروش';
const ctaLabel = mode === 'buy' ? 'ادامه و پرداخت' : 'ثبت درخواست فروش';
---

<div class="relative rounded-xl2 bg-white border border-brand-100/40 shadow-card-hover p-6 md:p-8 max-w-md mx-auto md:mx-0 overflow-hidden" data-calc-mode={mode}>
  <span class="absolute -top-12 -left-12 h-32 w-32 rounded-full brand-glow-bg blur-xl"></span>

  <div class="relative flex items-center gap-1.5 text-[12px] text-ink-soft mb-1">
    <span class="live-dot"></span>
    قیمت لحظه‌ای هر گرم طلای ۱۸ عیار
  </div>
  <p class="relative text-3xl font-extrabold text-brand tnum" data-price-bind="pricePerGram" data-price-format="toman">
    در حال دریافت...
  </p>

  <div id="calc-disabled-note" class="relative hidden mt-3 rounded-lg bg-danger-50 text-danger text-xs px-3 py-2"></div>

  <label for={`gold-grams-${mode}`} class="relative block mt-6 mb-2 text-sm font-medium text-ink-soft">
    مقدار طلا برای {label} (گرم)
  </label>
  <input
    id={`gold-grams-${mode}`}
    type="number"
    inputmode="decimal"
    min="0.1"
    step="0.1"
    value="1"
    class="calc-grams-input relative w-full rounded-lg border border-brand-100/40 px-4 py-3.5 text-base tnum focus:border-gold focus:outline-none focus:shadow-glow transition-shadow"
    aria-describedby={`gold-total-desc-${mode}`}
  />

  <dl class="relative mt-4 rounded-lg bg-canvas-100 px-4 py-3.5 space-y-2 text-sm">
    <div class="flex items-center justify-between text-ink-soft">
      <dt>ارزش طلا</dt>
      <dd class="calc-gold-value tnum">۰ تومان</dd>
    </div>
    <div class="flex items-center justify-between text-ink-soft">
      <dt>کارمزد معامله ({TRADE_FEE_LABEL}٪)</dt>
      <dd class="calc-fee tnum">۰ تومان</dd>
    </div>
    <div class="flex items-center justify-between border-t border-brand-100/40 pt-2">
      <dt class="text-ink-soft" id={`gold-total-desc-${mode}`}>{mode === 'buy' ? 'مبلغ قابل پرداخت' : 'مبلغ قابل دریافت'}</dt>
      <dd class="calc-total-price font-bold text-brand tnum text-lg">۰ تومان</dd>
    </div>
  </dl>

  <button
    type="button"
    class="calc-cta-btn btn-primary relative mt-6 w-full shine-hover"
    data-mode={mode}
    data-app-url={APP_URL}
  >
    <Icon name="wallet" class="h-4.5 w-4.5" />
    {ctaLabel}
  </button>
  <p class="relative mt-3 text-[12px] text-ink-soft/70 text-center">
    برای تکمیل معامله وارد اپلیکیشن آرکان گلد (app.arkan.gold) می‌شوید.
  </p>
</div>

<script>
  import { subscribeGoldPrice, formatToman, calcTradeFee, type NormalizedGoldPrice } from '../../lib/goldPrice';

  document.querySelectorAll<HTMLElement>('[data-calc-mode]').forEach((container) => {
    const mode = container.dataset.calcMode as 'buy' | 'sell';
    const gramsInput = container.querySelector<HTMLInputElement>('.calc-grams-input');
    const totalEl = container.querySelector<HTMLElement>('.calc-total-price');
    const goldValueEl = container.querySelector<HTMLElement>('.calc-gold-value');
    const feeEl = container.querySelector<HTMLElement>('.calc-fee');
    const ctaBtn = container.querySelector<HTMLButtonElement>('.calc-cta-btn');
    const disabledNote = container.querySelector<HTMLElement>('#calc-disabled-note');

    let currentUnitPrice = 0;

    function updateTotal() {
      const grams = parseFloat(gramsInput?.value || '0') || 0;
      const goldValue = Math.max(0, grams) * currentUnitPrice;
      const fee = calcTradeFee(goldValue);
      const total = mode === 'buy' ? goldValue + fee : goldValue - fee;
      if (goldValueEl) goldValueEl.textContent = formatToman(goldValue);
      if (feeEl) feeEl.textContent = formatToman(fee);
      if (totalEl) totalEl.textContent = formatToman(total);
    }

    function applyPrice(price: NormalizedGoldPrice) {
      currentUnitPrice = price.pricePerGram;
      updateTotal();

      const isDisabled = mode === 'buy' ? price.raw.disableBuy : price.raw.disableSell;
      const message = mode === 'buy' ? price.raw.disableBuyMessage : price.raw.disableSellMessage;

      if (disabledNote) {
        disabledNote.classList.toggle('hidden', !isDisabled);
        disabledNote.textContent = message || 'این نوع معامله در حال حاضر غیرفعال است.';
      }
      if (ctaBtn) {
        ctaBtn.toggleAttribute('disabled', isDisabled);
        ctaBtn.classList.toggle('opacity-50', isDisabled);
        ctaBtn.classList.toggle('cursor-not-allowed', isDisabled);
      }
    }

    subscribeGoldPrice(applyPrice);

    gramsInput?.addEventListener('input', updateTotal);
    ctaBtn?.addEventListener('click', () => {
      if (ctaBtn.hasAttribute('disabled')) return;
      window.location.href = ctaBtn.dataset.appUrl || '/login';
    });
  });
</script>
