---
// آخرین مطالب مجله در صفحه‌ی اصلی.
// - مجله‌ی هدلس فعال (PUBLIC_WP_API_URL): همان کارت صفحه‌های /mag با لینک داخلی. صفحه‌ی اصلی ایستاست،
//   پس کارت‌ها در build ساخته و در مرورگر از REST API وردپرس به‌روز می‌شوند تا مطلب تازه هم بدون
//   build جدید دیده شود (اگر وردپرس هنگام build در دسترس نباشد، بخش در مرورگر پر می‌شود).
// - در غیر این صورت: از REST API وردپرس فعلی (arkan.gold/mag) خوانده می‌شود و اگر در دسترس
//   نباشد این بخش بی‌صدا حذف می‌شود (خطا صفحه را نمی‌شکند).
import { MAG_ENABLED, MAG_NAME } from '../../config/site';
import { MAG_URL } from '../../data/nav';
import { latestPosts } from '../../lib/magazine';
import { magCardHtml, type MagPost } from '../../lib/wp';

interface WpPost {
  id: number;
  link: string;
  title: { rendered: string };
  excerpt: { rendered: string };
  date: string;
}

let magPosts: MagPost[] = [];
let legacyPosts: WpPost[] = [];

if (MAG_ENABLED) {
  magPosts = await latestPosts(3).catch((err) => {
    console.warn('[mag] مطالب صفحه‌ی اصلی در build خوانده نشد؛ در مرورگر بارگذاری می‌شوند:', err?.message ?? err);
    return [];
  });
} else {
  try {
    const res = await fetch('https://arkan.gold/mag/wp-json/wp/v2/posts?per_page=3&_fields=id,link,title,excerpt,date', {
      signal: AbortSignal.timeout(4000),
    });
    if (res.ok) legacyPosts = await res.json();
  } catch {
    legacyPosts = [];
  }
}

const stripHtml = (html: string) => html.replace(/<[^>]*>/g, '').trim();
const hasPosts = magPosts.length > 0 || legacyPosts.length > 0;
---

{(hasPosts || MAG_ENABLED) && (
  <section class:list={['container-page py-14', { hidden: !hasPosts }]} data-mag-teaser={MAG_ENABLED ? '' : undefined}>
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xl md:text-2xl font-bold text-brand">مطالب {MAG_NAME}</h2>
      <a
        href={MAG_URL}
        target={MAG_ENABLED ? undefined : '_blank'}
        rel={MAG_ENABLED ? undefined : 'noopener'}
        class="text-sm text-brand hover:underline"
      >
        مشاهده همه مطالب
      </a>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-mag-teaser-grid>
      {magPosts.map((post) => <Fragment set:html={magCardHtml(post, { headingTag: 'h3' })} />)}
      {legacyPosts.map((post) => (
        <a
          href={post.link}
          target="_blank"
          rel="noopener"
          class="block rounded-card bg-white border border-brand-100/40 shadow-card p-5 hover:border-brand transition-colors card-lift"
        >
          <h3 class="font-semibold text-brand mb-2 line-clamp-2" set:html={post.title.rendered} />
          <p class="text-xs leading-6 text-ink-soft line-clamp-3">{stripHtml(post.excerpt.rendered)}</p>
          <time datetime={post.date} class="mt-3 block text-[11px] text-ink-soft/70 tnum">
            {new Date(post.date).toLocaleDateString('fa-IR')}
          </time>
        </a>
      ))}
    </div>
  </section>
)}

<script>
  import { WP_API_URL } from '../../config/site';
  import { WP_EMBED, fetchSiteInfo, magCardHtml, toMagPost, wpGet, type WpPost } from '../../lib/wp';

  // آخرین مطالب مجله مستقیم از وردپرس (صفحه‌ی اصلی ایستاست و مطلب جدید بدون build دیده می‌شود)
  const section = document.querySelector<HTMLElement>('[data-mag-teaser]');
  if (section && WP_API_URL) {
    Promise.all([fetchSiteInfo(), wpGet<WpPost[]>('wp/v2/posts', { per_page: 3, _embed: WP_EMBED })])
      .then(([site, res]) => {
        const posts = res.data.map((p) => toMagPost(p, site.home)).filter((p) => !!p);
        if (!posts.length) return;
        section.querySelector('[data-mag-teaser-grid]')!.innerHTML = posts.map((p) => magCardHtml(p!, { headingTag: 'h3' })).join('');
        section.classList.remove('hidden');
      })
      .catch(() => {});
  }
</script>
