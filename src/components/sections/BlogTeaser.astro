---
// آخرین مطالب مجله در صفحه‌ی اصلی.
// - مجله‌ی هدلس فعال (PUBLIC_WP_API_URL): همان داده‌ی صفحه‌های /mag و همان کارت مطلب، با لینک داخلی
// - در غیر این صورت: از REST API وردپرس فعلی (arkan.gold/mag) خوانده می‌شود و اگر در دسترس
//   نباشد این بخش بی‌صدا حذف می‌شود (خطا صفحه را نمی‌شکند).
import { MAG_ENABLED, MAG_NAME } from '../../config/site';
import { MAG_URL } from '../../data/nav';
import { loadMagazine } from '../../lib/magazine';
import { magCardHtml, type MagPost } from '../../lib/wp';

interface WpPost {
  id: number;
  link: string;
  title: { rendered: string };
  excerpt: { rendered: string };
  date: string;
}

let magPosts: MagPost[] = [];
let legacyPosts: WpPost[] = [];

if (MAG_ENABLED) {
  magPosts = (await loadMagazine()).posts.slice(0, 3);
} else {
  try {
    const res = await fetch('https://arkan.gold/mag/wp-json/wp/v2/posts?per_page=3&_fields=id,link,title,excerpt,date', {
      signal: AbortSignal.timeout(4000),
    });
    if (res.ok) legacyPosts = await res.json();
  } catch {
    legacyPosts = [];
  }
}

const stripHtml = (html: string) => html.replace(/<[^>]*>/g, '').trim();
const hasPosts = magPosts.length > 0 || legacyPosts.length > 0;
---

{hasPosts && (
  <section class="container-page py-14">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-xl md:text-2xl font-bold text-brand">مطالب {MAG_NAME}</h2>
      <a
        href={MAG_URL}
        target={MAG_ENABLED ? undefined : '_blank'}
        rel={MAG_ENABLED ? undefined : 'noopener'}
        class="text-sm text-brand hover:underline"
      >
        مشاهده همه مطالب
      </a>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {magPosts.map((post) => <Fragment set:html={magCardHtml(post, { headingTag: 'h3' })} />)}
      {legacyPosts.map((post) => (
        <a
          href={post.link}
          target="_blank"
          rel="noopener"
          class="block rounded-card bg-white border border-brand-100/40 shadow-card p-5 hover:border-brand transition-colors card-lift"
        >
          <h3 class="font-semibold text-brand mb-2 line-clamp-2" set:html={post.title.rendered} />
          <p class="text-xs leading-6 text-ink-soft line-clamp-3">{stripHtml(post.excerpt.rendered)}</p>
          <time datetime={post.date} class="mt-3 block text-[11px] text-ink-soft/70 tnum">
            {new Date(post.date).toLocaleDateString('fa-IR')}
          </time>
        </a>
      ))}
    </div>
  </section>
)}
