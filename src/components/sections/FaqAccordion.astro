---
import type { FaqItem } from '../../data/faq';

interface Props {
  items: FaqItem[];
  idPrefix?: string;
}
const { items, idPrefix = 'faq' } = Astro.props;
---

<div class="divide-y divide-gold-100 rounded-card bg-white border border-gold-100/70 shadow-card overflow-hidden">
  {items.map((item, i) => {
    const panelId = `${idPrefix}-panel-${i}`;
    const btnId = `${idPrefix}-btn-${i}`;
    return (
      <div>
        <h3>
          <button
            id={btnId}
            aria-expanded="false"
            aria-controls={panelId}
            class="faq-trigger w-full flex items-center justify-between gap-4 px-5 py-4 text-right text-sm font-semibold text-maroon hover:bg-cream-50 transition-colors"
          >
            <span>{item.question}</span>
            <span class="faq-icon shrink-0 text-gold text-lg leading-none transition-transform" aria-hidden="true">+</span>
          </button>
        </h3>
        <div id={panelId} role="region" aria-labelledby={btnId} class="faq-panel hidden px-5 pb-4">
          <p class="text-sm leading-7 text-ink-soft">{item.answer}</p>
        </div>
      </div>
    );
  })}
</div>

<script>
  document.querySelectorAll('.faq-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const panel = document.getElementById(btn.getAttribute('aria-controls') || '');
      const icon = btn.querySelector('.faq-icon');
      btn.setAttribute('aria-expanded', String(!expanded));
      panel?.classList.toggle('hidden', expanded);
      if (icon) icon.textContent = expanded ? '+' : '−';
    });
  });
</script>
