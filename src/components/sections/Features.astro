---
const features = [
  {
    title: 'امنیت سرمایه',
    desc: 'پشتوانه طلای شما در خزانه رسمی بانک نگهداری می‌شود.',
    icon: 'lock',
  },
  {
    title: 'بدون اجرت و کارمزد',
    desc: 'معامله طلا بدون امکان پرداخت اجرت‌های اضافه.',
    icon: 'percent',
  },
  {
    title: 'معامله ۲۴ ساعته',
    desc: 'در هر ساعت از شبانه‌روز امکان خرید و فروش دارید.',
    icon: 'clock',
  },
  {
    title: 'فاکتور رسمی',
    desc: 'تمامی خریدها با فاکتور معتبر و قابل استناد ثبت می‌شوند.',
    icon: 'invoice',
  },
];

const icons: Record<string, string> = {
  lock: 'M12 2a5 5 0 00-5 5v3H6a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2v-8a2 2 0 00-2-2h-1V7a5 5 0 00-5-5zm-3 8V7a3 3 0 016 0v3H9z',
  percent: 'M19 5L5 19M7.5 9a2.5 2.5 0 100-5 2.5 2.5 0 000 5zm9 10a2.5 2.5 0 100-5 2.5 2.5 0 000 5z',
  clock: 'M12 21a9 9 0 100-18 9 9 0 000 18zm0-14v5l3.5 2',
  invoice: 'M8 2h8a2 2 0 012 2v16l-3-2-3 2-3-2-3 2V4a2 2 0 012-2zM9 8h6M9 12h6',
};
---

<section class="container-page py-14">
  <div class="text-center mb-10">
    <p class="text-xs font-semibold text-gold mb-2">مزایای آرکان گلد</p>
    <h2 class="text-xl md:text-2xl font-bold text-maroon">چرا آرکان گلد را انتخاب کنیم؟</h2>
    <p class="mt-2 text-sm text-ink-soft max-w-xl mx-auto">
      با آرکان گلد، طلا را مطمئن، بدون اجرت و با پشتیبانی واقعی بخرید و بفروشید.
    </p>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {features.map((f) => (
      <div class="rounded-card bg-white p-6 shadow-card border border-gold-100/70 text-center">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-gold-50">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-gold-600">
            <path d={icons[f.icon]} stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <h3 class="font-semibold text-maroon mb-1.5">{f.title}</h3>
        <p class="text-xs leading-6 text-ink-soft">{f.desc}</p>
      </div>
    ))}
  </div>
</section>
