---
import Icon from '../Icon.astro';

const features = [
  {
    title: 'امنیت سرمایه',
    desc: 'پشتوانه طلای شما در خزانه رسمی بانک نگهداری می‌شود.',
    icon: 'lock',
  },
  {
    title: 'بدون اجرت و کارمزد',
    desc: 'معامله طلا بدون امکان پرداخت اجرت‌های اضافه.',
    icon: 'percent',
  },
  {
    title: 'معامله ۲۴ ساعته',
    desc: 'در هر ساعت از شبانه‌روز امکان خرید و فروش دارید.',
    icon: 'clock',
  },
  {
    title: 'فاکتور رسمی',
    desc: 'تمامی خریدها با فاکتور معتبر و قابل استناد ثبت می‌شوند.',
    icon: 'invoice',
  },
];
---

<section class="container-page py-14">
  <div class="text-center mb-10">
    <p class="text-xs font-semibold text-brand mb-2">مزایای آرکان گلد</p>
    <h2 class="text-2xl font-bold text-brand">چرا آرکان گلد را انتخاب کنیم؟</h2>
    <p class="mt-2 text-base text-ink-soft max-w-xl mx-auto">
      با آرکان گلد، طلا را مطمئن، بدون اجرت و با پشتیبانی واقعی بخرید و بفروشید.
    </p>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {features.map((f) => (
      <div class="group rounded-xl2 bg-white p-6 shadow-card border border-brand-100/40 text-center card-lift shine-hover">
        <div class="mx-auto mb-4 flex h-13 w-13 items-center justify-center rounded-full bg-brand-50 transition-all duration-300 group-hover:bg-brand group-hover:shadow-glow" style="height:3.25rem;width:3.25rem;">
          <Icon name={f.icon as any} class="h-6 w-6 text-brand transition-colors duration-300 group-hover:text-white" />
        </div>
        <h3 class="font-semibold text-brand mb-1.5 text-lg">{f.title}</h3>
        <p class="text-sm leading-6 text-ink-soft">{f.desc}</p>
      </div>
    ))}
  </div>
</section>
