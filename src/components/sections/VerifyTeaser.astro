---
import Icon from '../Icon.astro';
---

<section class="container-page py-10">
  <div class="relative overflow-hidden rounded-xl2 bg-brand-radial text-white p-5 sm:p-7 md:p-10 grid grid-cols-1 gap-6 lg:grid-cols-2 items-center shadow-glow-brand">
    <div class="pointer-events-none absolute inset-0 dot-grid-bg opacity-[0.07]"></div>
    <div class="relative min-w-0">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-xs font-medium text-white/90">
        <Icon name="shield" class="h-4 w-4 text-gold" />
        رایگان، آنلاین و ۲۴ ساعته
      </span>
      <h2 class="mt-3 text-xl sm:text-2xl font-bold leading-9">استعلام اصالت شمش آرکان گلد</h2>
      <p class="mt-2 text-sm leading-7 text-white/80 text-justify">
        هر شمش آرکان گلد یک کد ۶ رقمی یکتا روی هولوگرام کارت پلمپ دارد. کد را وارد کنید و
        مشخصات، مالک و وضعیت شمش را همین حالا بررسی کنید.
      </p>
    </div>
    <form action="/verify" method="get" class="relative flex min-w-0 flex-col sm:flex-row gap-3">
      <label for="teaser-code" class="sr-only">کد ۶ رقمی اصالت شمش</label>
      <input
        id="teaser-code"
        name="code"
        type="text"
        dir="ltr"
        inputmode="numeric"
        required
        maxlength="6"
        size="6"
        autocomplete="off"
        placeholder="123456"
        class="block w-full min-w-0 flex-1 rounded-lg border border-white/20 bg-white/95 px-4 py-3.5 text-lg font-bold text-ink text-center tracking-[0.25em] sm:tracking-[0.4em] latin-digits focus:outline-none focus:ring-2 focus:ring-gold"
      />
      <button type="submit" class="btn-light w-full sm:w-auto shrink-0 whitespace-nowrap">
        <Icon name="shield" class="h-4.5 w-4.5" /> استعلام اصالت
      </button>
    </form>
  </div>
</section>
