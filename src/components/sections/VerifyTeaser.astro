---
import Icon from '../Icon.astro';
---

<section class="container-page py-10">
  <div class="relative overflow-hidden rounded-xl2 bg-brand-radial text-white p-7 md:p-10 grid gap-6 lg:grid-cols-[1fr_1fr] items-center shadow-glow-brand">
    <div class="pointer-events-none absolute inset-0 dot-grid-bg opacity-[0.07]"></div>
    <div class="relative">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1.5 text-xs font-medium text-white/90">
        <Icon name="shield" class="h-4 w-4 text-gold" />
        رایگان، آنلاین و ۲۴ ساعته
      </span>
      <h2 class="mt-3 text-2xl font-bold">استعلام اصالت شمش آرکان گلد</h2>
      <p class="mt-2 text-sm leading-7 text-white/80">
        هر شمش ۷۵۰ عیار آرکان گلد سریال یکتا دارد. سریال پشت کارت پلمپ را وارد کنید و وزن،
        عیار و وضعیت شمش را همین حالا بررسی کنید.
      </p>
    </div>
    <form action="/verify" method="get" class="relative flex flex-col sm:flex-row gap-3">
      <label for="teaser-serial" class="sr-only">شماره سریال شمش</label>
      <input
        id="teaser-serial"
        name="serial"
        type="text"
        dir="ltr"
        required
        maxlength="40"
        autocomplete="off"
        placeholder="AG750-000123"
        class="flex-1 rounded-lg border border-white/20 bg-white/95 px-4 py-3.5 text-base text-ink text-center tracking-wider latin-digits focus:outline-none focus:ring-2 focus:ring-gold"
      />
      <button type="submit" class="btn-light whitespace-nowrap">
        <Icon name="shield" class="h-4.5 w-4.5" /> استعلام اصالت
      </button>
    </form>
  </div>
</section>
