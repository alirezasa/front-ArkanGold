---
const steps = [
  {
    n: '۱',
    title: 'ثبت‌نام',
    desc: 'پس از ثبت‌نام با شماره موبایل خود، وارد آرکان گلد شوید.',
  },
  {
    n: '۲',
    title: 'احراز هویت',
    desc: 'با ثبت اطلاعات هویتی، در کمتر از ۱ دقیقه احراز هویت کنید.',
  },
  {
    n: '۳',
    title: 'خرید آنلاین',
    desc: 'میزان طلا یا نقره مورد نظر خود را وارد کرده و مبلغ آن را آنلاین پرداخت کنید.',
  },
  {
    n: '۴',
    title: 'تحویل فیزیکی',
    desc: 'در بخش تحویل فیزیکی با انتخاب آدرس ثبت‌شده، طلای خریداری‌شده را تحویل بگیرید.',
  },
];
---

<section class="relative bg-canvas-200/50 py-14 overflow-hidden">
  <div class="pointer-events-none absolute inset-0 dot-grid-bg opacity-30"></div>
  <div class="container-page relative grid gap-10 md:grid-cols-2 items-start">
    <div class="text-center md:text-right">
      <p class="text-sm text-ink-soft mb-2">خرید آسان طلای آب‌شده تنها در ۴ مرحله</p>
      <h2 class="text-2xl font-bold text-brand">شروع آسان با آرکان گلد</h2>
      <p class="mt-2 text-base text-ink-soft">چطور آنلاین طلا و نقره بخریم؟</p>
      <a
        href="/faq"
        class="btn-outline mt-6"
      >
        مشاهده سوالات متداول
      </a>
    </div>

    <ol class="relative space-y-3">
      <span class="absolute right-[17px] top-4 bottom-4 hidden sm:block w-px gold-divider"></span>
      {steps.map((s) => (
        <li class="relative flex items-start gap-4 rounded-card bg-white p-5 shadow-card border border-brand-100/40 card-lift">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-cta-gradient text-sm font-bold text-white tnum shadow-glow-brand">
            {s.n}
          </span>
          <div>
            <h3 class="font-semibold text-brand mb-1 text-lg">{s.title}</h3>
            <p class="text-sm leading-6 text-ink-soft">{s.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
