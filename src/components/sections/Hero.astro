---
import Icon from '../Icon.astro';
import { APP_URL, TRADE_FEE_LABEL } from '../../config/site';

const trustItems = [
  'مجوز فینتک',
  'تحویل فیزیکی',
  'قیمت رقابتی',
  'خزانه بانکی امن',
  'تضمین دارایی',
];

// زیرعنوان‌ها کوتاه و تک‌خطی هستند
const miniCards: { title: string; desc: string; icon: string; href?: string; chat?: boolean }[] = [
  { title: 'کسب درآمد', desc: 'پاداش به ازای هر معرفی', icon: 'gift-card' },
  { title: 'تحویل فیزیکی', desc: 'در قالب شمش آرکان', icon: 'gold-bar', href: '/delivery' },
  { title: 'پشتیبانی سریع', desc: 'پاسخگویی هر روز هفته', icon: 'headset', chat: true },
];
---

<section class="relative overflow-hidden pt-8 pb-16 md:pt-14 md:pb-24">
  <div class="pointer-events-none absolute inset-0 dot-grid-bg opacity-40 [mask-image:radial-gradient(60%_60%_at_50%_0%,black,transparent)]"></div>
  <div class="pointer-events-none absolute -top-24 -left-24 h-72 w-72 rounded-full brand-glow-bg blur-2xl"></div>

  <div class="container-page relative">
    <div class="grid items-center gap-10 md:grid-cols-2 xl:grid-cols-[0.8fr_1.2fr]">
      <div class="order-2 md:order-1 flex justify-center">
        <div class="relative">
          <div class="absolute inset-0 -z-10 brand-glow-bg blur-xl"></div>
          <img
            src="/images/hero-arkan-bullion.svg"
            alt="شمش‌های ۷۵۰ عیار آرکان گلد و طلای آب‌شده در کنار صندوق ایمن"
            width="560"
            height="480"
            class="w-full max-w-md drop-shadow-xl floaty-img"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="order-1 md:order-2 text-center md:text-right">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-brand-100/40 bg-white/70 px-3 py-1.5 text-xs font-medium text-brand shadow-sm">
          <span class="live-dot"></span>
          نرخ لحظه‌ای بازار فعال است
        </span>

        <p class="mt-4 text-2xl font-extrabold text-brand mb-2">آرکان گلد؛</p>
        <h1 class="text-3xl md:text-4xl leading-[1.4] font-bold text-brand">
          خرید و فروش آنلاین طلای آب‌شده با پشتوانه واقعی
        </h1>
        <p class="mt-4 text-base leading-8 text-ink-soft">
          خرید آنلاین طلای آب‌شده بدون مالیات با امکان تحویل فیزیکی، و خرید شمش طلای ۷۵۰ عیار
          آرکان با فاکتور رسمی و کد اصالت قابل استعلام.
        </p>

        <!-- ترتیب: دو دکمه‌ی اصلی، سپس استعلام اصالت (در دسکتاپ بعد از دکمه‌ها، در موبایل زیر آن‌ها) -->
        <div class="hero-actions mt-7 flex flex-col sm:flex-row sm:flex-wrap justify-center md:justify-start gap-3">
          <a href="/buy-gold" class="btn-primary shine-hover">
            <Icon name="gold-drop" class="h-4.5 w-4.5" />
            خرید طلای آب‌شده
          </a>
          <a href="/shop" class="btn-primary shine-hover">
            <Icon name="gold-bar" class="h-4.5 w-4.5" />
            خرید شمش طلا
          </a>
          <a href="/verify" class="btn-outline">
            <Icon name="shield" class="h-4.5 w-4.5" />
            استعلام اصالت شمش
          </a>
        </div>
      </div>
    </div>

    <!-- کارت‌های کوچک اعتماد -->
    <div class="mt-10 grid gap-3 sm:grid-cols-3 max-w-3xl mx-auto md:mx-0">
      {miniCards.map((m) => {
        const Tag = m.href ? 'a' : m.chat ? 'button' : 'div';
        return (
          <Tag
            href={m.href}
            type={m.chat ? 'button' : undefined}
            data-support-chat={m.chat ? '' : undefined}
            class="flex min-w-0 items-center gap-3 rounded-xl2 bg-white/80 border border-brand-100/40 px-4 py-3 shadow-card card-lift text-right"
          >
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand">
              <Icon name={m.icon as any} class="h-5 w-5" />
            </span>
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-brand">{m.title}</span>
              <span class="block truncate whitespace-nowrap text-[11.5px] leading-5 text-ink-soft">{m.desc}</span>
            </span>
          </Tag>
        );
      })}
    </div>

    <!-- ماشین‌حساب زنده خرید/فروش -->
    <div class="mt-10 grid gap-5 lg:grid-cols-[1.2fr_1fr]">
      <div class="rounded-xl2 bg-white border border-brand-100/40 shadow-card-hover p-6 md:p-8">
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center gap-1.5 text-xs text-ink-soft">
            <span class="live-dot"></span>
            نرخ بازار
          </div>
          <div class="flex rounded-full bg-canvas-100 p-1" role="tablist" aria-label="نوع معامله">
            <button type="button" id="tab-buy" class="calc-tab rounded-full px-5 py-2 text-xs font-semibold transition-all" data-active="true">خرید</button>
            <button type="button" id="tab-sell" class="calc-tab rounded-full px-5 py-2 text-xs font-semibold transition-all" data-active="false">فروش</button>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-[1fr_auto_1fr] items-end">
          <div>
            <label for="hero-grams" class="block mb-1.5 text-sm font-medium text-ink-soft">مقدار طلا (گرم)</label>
            <div class="relative">
              <input
                id="hero-grams"
                type="number"
                inputmode="decimal"
                min="0.1"
                step="0.1"
                value="1"
                class="w-full rounded-lg border border-brand-100/40 px-4 py-3.5 text-base tnum focus:border-gold focus:outline-none focus:shadow-glow transition-shadow"
              />
              <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-xs text-ink-soft/60">گرم</span>
            </div>
          </div>

          <button type="button" id="hero-swap" aria-label="جابه‌جایی بین گرم و تومان" class="mb-1 flex h-11 w-11 items-center justify-center self-end rounded-full border border-brand-100/40 text-brand hover:bg-brand-50 transition-colors">
            <Icon name="trend-up" class="h-5 w-5 rotate-90" />
          </button>

          <div>
            <label for="hero-toman" class="block mb-1.5 text-sm font-medium text-ink-soft">مبلغ با کارمزد (تومان)</label>
            <div class="relative">
              <input
                id="hero-toman"
                type="text"
                inputmode="decimal"
                autocomplete="off"
                placeholder="۰"
                class="w-full rounded-lg border border-brand-100/40 px-4 py-3.5 text-base tnum focus:border-gold focus:outline-none focus:shadow-glow transition-shadow"
              />
              <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-xs text-ink-soft/60">تومان</span>
            </div>
          </div>
        </div>

        <p id="hero-calc-note" class="mt-4 text-xs text-ink-soft/70">
          خرید شما با قیمت لحظه‌ای و {TRADE_FEE_LABEL}٪ کارمزد انجام می‌شود.
        </p>

        <a href={APP_URL} id="hero-cta" class="btn-primary mt-5 w-full shine-hover">
          ادامه و پرداخت
        </a>
      </div>

      <div class="rounded-xl2 bg-cta-gradient text-white shadow-glow-brand p-6 md:p-8 flex flex-col justify-between">
        <div>
          <p class="text-xs text-white/60 mb-1">مبدل هوشمند طلا</p>
          <h3 class="text-lg font-bold mb-4">مقدار را وارد کن، نتیجه را لحظه‌ای ببین</h3>
          <p class="text-sm leading-6 text-white/75">
            برای مشاهده جزئیات کامل نرخ‌ها، نمودار تحلیلی و مقایسه بازارها به صفحه قیمت
            لحظه‌ای سر بزنید.
          </p>
        </div>
        <div class="mt-6 grid grid-cols-2 gap-3">
          <div class="glass-panel rounded-lg px-4 py-3 text-center">
            <p class="text-[11px] text-white/70 mb-1">قیمت هر گرم ۱۸ عیار</p>
            <p class="font-bold tnum" data-price-bind="pricePerGram">--</p>
          </div>
          <div class="glass-panel rounded-lg px-4 py-3 text-center">
            <p class="text-[11px] text-white/70 mb-1">تغییر ۲۴ ساعته</p>
            <p class="font-bold tnum" data-price-bind="changePercent">--</p>
          </div>
        </div>
        <a href="/price" class="btn-light mt-5 w-full">مشاهده قیمت لحظه‌ای</a>
      </div>
    </div>
  </div>

  <ul class="mt-14 container-page flex flex-wrap items-center justify-center gap-x-10 gap-y-4 text-sm text-ink-soft">
    {trustItems.map((item) => (
      <li class="flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
        {item}
      </li>
    ))}
  </ul>
</section>

<style>
  /* دکمه‌های هیرو با اندازه‌ی استاندارد و یکسان */
  .hero-actions > a {
    min-height: 3rem;
    padding: 0.7rem 1.15rem;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .calc-tab[data-active="true"] {
    background: linear-gradient(135deg, #7a171e, #330509);
    color: #ffffff;
    box-shadow: 0 6px 16px -6px rgba(51, 5, 9, 0.5);
  }
  .calc-tab[data-active="false"] {
    color: #5c5449;
  }
</style>

<script>
  import { subscribeGoldPrice, formatToman, calcTradeFee, type NormalizedGoldPrice } from '../../lib/goldPrice';
  import { TRADE_FEE_LABEL } from '../../config/site';

  const gramsInput = document.getElementById('hero-grams') as HTMLInputElement | null;
  const tomanInput = document.getElementById('hero-toman') as HTMLInputElement | null;
  const tabBuy = document.getElementById('tab-buy');
  const tabSell = document.getElementById('tab-sell');
  const note = document.getElementById('hero-calc-note');
  const cta = document.getElementById('hero-cta') as HTMLAnchorElement | null;
  const swapBtn = document.getElementById('hero-swap');

  let mode: 'buy' | 'sell' = 'buy';
  let unitPrice = 0;
  let disabled = { buy: false, sell: false };

  /** وقتی API خرید یا فروش را غیرفعال کرده باشد (disableBuy / disableSell) */
  function applyAvailability() {
    const off = disabled[mode];
    cta?.classList.toggle('opacity-50', off);
    cta?.classList.toggle('pointer-events-none', off);
    if (off) cta?.setAttribute('aria-disabled', 'true');
    else cta?.removeAttribute('aria-disabled');
    if (off && note) note.textContent = mode === 'buy' ? 'خرید در حال حاضر موقتاً غیرفعال است.' : 'فروش در حال حاضر موقتاً غیرفعال است.';
  }

  /** فیلدی که کاربر آخرین بار تایپ کرده؛ با تغییر قیمت یا نوع معامله، فیلد مقابل از روی همین محاسبه می‌شود */
  let source: 'grams' | 'toman' = 'grams';

  const feeRate = () => calcTradeFee(1);

  /** تبدیل ورودی کاربر (ارقام فارسی/عربی، جداکننده‌ی هزارگان) به عدد */
  function parseNumber(value: string): number {
    const normalized = value
      .replace(/[۰-۹]/g, (d) => String(d.charCodeAt(0) - 0x06f0))
      .replace(/[٠-٩]/g, (d) => String(d.charCodeAt(0) - 0x0660))
      .replace(/[٫]/g, '.')
      .replace(/[^\d.]/g, '');
    return parseFloat(normalized) || 0;
  }

  /** گرم ← مبلغ: خرید = ارزش + کارمزد، فروش = ارزش − کارمزد */
  function gramsToToman(grams: number): number {
    const goldValue = Math.max(0, grams) * unitPrice;
    const fee = calcTradeFee(goldValue);
    return mode === 'buy' ? goldValue + fee : goldValue - fee;
  }

  /** مبلغ ← گرم (معکوس gramsToToman) */
  function tomanToGrams(toman: number): number {
    const perGram = unitPrice * (mode === 'buy' ? 1 + feeRate() : 1 - feeRate());
    return perGram > 0 ? Math.max(0, toman) / perGram : 0;
  }

  function updateTotal() {
    if (!unitPrice) return;
    if (source === 'grams') {
      const total = gramsToToman(parseFloat(gramsInput?.value || '0') || 0);
      if (tomanInput) tomanInput.value = formatToman(total).replace(' تومان', '');
    } else {
      const grams = tomanToGrams(parseNumber(tomanInput?.value || ''));
      if (gramsInput) gramsInput.value = grams ? String(Math.round(grams * 1000) / 1000) : '';
    }
  }

  function setMode(next: 'buy' | 'sell') {
    mode = next;
    tabBuy?.setAttribute('data-active', String(next === 'buy'));
    tabSell?.setAttribute('data-active', String(next === 'sell'));
    if (note) note.textContent = next === 'buy'
      ? `خرید شما با قیمت لحظه‌ای و ${TRADE_FEE_LABEL}٪ کارمزد انجام می‌شود.`
      : `فروش شما با قیمت لحظه‌ای و ${TRADE_FEE_LABEL}٪ کارمزد ثبت و در چند ساعت کاری تسویه می‌شود.`;
    updateTotal();
    if (cta) cta.textContent = next === 'buy' ? 'ادامه و پرداخت' : 'ثبت درخواست فروش';
    applyAvailability();
  }

  subscribeGoldPrice((price: NormalizedGoldPrice) => {
    unitPrice = price.pricePerGram;
    disabled = { buy: !!price.raw.disableBuy, sell: !!price.raw.disableSell };
    updateTotal();
    applyAvailability();
  });

  gramsInput?.addEventListener('input', () => {
    source = 'grams';
    updateTotal();
  });
  tomanInput?.addEventListener('input', () => {
    source = 'toman';
    // نمایش مبلغ با جداکننده‌ی هزارگان در حین تایپ
    const amount = Math.floor(parseNumber(tomanInput.value));
    tomanInput.value = amount ? formatToman(amount).replace(' تومان', '') : '';
    updateTotal();
  });
  tabBuy?.addEventListener('click', () => setMode('buy'));
  tabSell?.addEventListener('click', () => setMode('sell'));
  swapBtn?.addEventListener('click', () => {
    const target = source === 'grams' ? tomanInput : gramsInput;
    target?.focus();
    target?.select();
    target?.classList.add('animate-pulse');
    setTimeout(() => target?.classList.remove('animate-pulse'), 300);
  });
</script>

<script>
  import '../../lib/priceBinding';
</script>
