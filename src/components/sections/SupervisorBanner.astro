---
/**
 * اتصال به سامانه ناظر بانک مرکزی — خرید و فروش طلای آب‌شده با تایید ناظر
 * بخش شفاف و برجسته‌ی صفحه‌ی اصلی (لینک «اتصال به سامانه ناظر» در نوار مجوزها به اینجا می‌آید)
 */
import Icon from '../Icon.astro';

const flow = [
  { title: 'ثبت سفارش', desc: 'خرید یا فروش طلای آب‌شده در پنل', icon: 'wallet' },
  { title: 'ارسال به سامانه ناظر', desc: 'ثبت معامله در سامانه ناظر بانک مرکزی', icon: 'transfer' },
  { title: 'تایید ناظر', desc: 'بررسی و تایید معامله توسط ناظر', icon: 'shield' },
  { title: 'ثبت در کیف طلایی', desc: 'نمایش موجودی تاییدشده در حساب شما', icon: 'gold-drop' },
] as const;

const points = [
  { title: 'ثبت تک‌تک معاملات', desc: 'هر خرید و فروش طلای آب‌شده در سامانه ناظر بانک مرکزی ثبت می‌شود.', icon: 'invoice' },
  { title: 'معامله با تایید ناظر', desc: 'معاملات پس از تایید ناظر نهایی می‌شوند؛ هیچ معامله‌ای خارج از سامانه انجام نمی‌شود.', icon: 'shield' },
  { title: 'پشتوانه‌ی فیزیکی واقعی', desc: 'موجودی طلای کاربران با شمش‌های نگهداری‌شده در خزانه تطبیق داده می‌شود.', icon: 'vault' },
  { title: 'شفافیت برای شما', desc: 'وضعیت و سوابق هر معامله در پنل کاربری شما قابل پیگیری است.', icon: 'document' },
] as const;
---

<section id="supervisor" class="container-page py-12 scroll-mt-40">
  <div class="relative overflow-hidden rounded-xl2 bg-brand-radial text-white shadow-glow-brand">
    <div class="pointer-events-none absolute inset-0 dot-grid-bg opacity-[0.07]"></div>
    <div class="pointer-events-none absolute -top-24 -left-24 h-64 w-64 rounded-full bg-gold/10 blur-3xl"></div>

    <div class="relative grid gap-8 p-6 sm:p-8 md:p-10 lg:grid-cols-[1fr_1.05fr] lg:items-center">
      <div class="text-center lg:text-right">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-gold/30 bg-white/10 px-3 py-1.5 text-xs font-semibold text-gold-300">
          <span class="live-dot"></span>
          متصل به سامانه ناظر بانک مرکزی
        </span>
        <h2 class="mt-4 text-2xl md:text-[1.95rem] font-extrabold leading-[1.5]">
          خرید و فروش طلای آب‌شده
          <span class="block text-gold-300">با تایید ناظر</span>
        </h2>
        <p class="mt-4 text-sm sm:text-base leading-8 text-white/80 max-w-xl mx-auto lg:mx-0">
          آرکان گلد به سامانه ناظر بانک مرکزی متصل است؛ یعنی هر خرید و فروش طلای آب‌شده‌ی شما
          پس از ثبت در سامانه ناظر و تایید آن نهایی می‌شود و موجودی شما با پشتوانه‌ی واقعی طلا
          در خزانه همخوانی دارد. شفافیت، امنیت و اطمینان در هر معامله.
        </p>

        <ul class="mt-6 grid gap-3 sm:grid-cols-2 text-right">
          {points.map((p) => (
            <li class="glass-panel flex items-start gap-3 rounded-card p-3.5">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gold/15 text-gold-300">
                <Icon name={p.icon} class="h-[18px] w-[18px]" />
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-bold">{p.title}</span>
                <span class="block text-xs leading-6 text-white/70">{p.desc}</span>
              </span>
            </li>
          ))}
        </ul>

      </div>

      <!-- مسیر هر معامله تا تایید ناظر -->
      <div class="rounded-xl2 bg-white text-ink p-5 sm:p-6 shadow-card-hover">
        <p class="text-center text-sm font-bold text-brand">مسیر هر معامله در آرکان گلد</p>
        <p class="mt-1 text-center text-xs text-ink-soft">از ثبت سفارش تا تایید ناظر</p>
        <ol class="relative mt-5 space-y-3">
          <span class="absolute right-[21px] top-6 bottom-6 w-px bg-brand-100" aria-hidden="true"></span>
          {flow.map((f, i) => (
            <li class:list={['relative flex items-center gap-3 rounded-card border p-3', i === 2 ? 'border-success/30 bg-success-50' : 'border-brand-100/40 bg-canvas-50']}>
              <span class:list={['relative flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-white', i === 2 ? 'bg-success' : 'bg-cta-gradient']}>
                <Icon name={f.icon} class="h-5 w-5" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-bold text-brand">
                  <span class="tnum text-ink-soft">{(i + 1).toLocaleString('fa-IR')}.</span> {f.title}
                </span>
                <span class="block text-xs leading-6 text-ink-soft">{f.desc}</span>
              </span>
              {i === 2 && <span class="shrink-0 rounded-full bg-success px-2.5 py-1 text-[11px] font-bold text-white">✓ تایید</span>}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
