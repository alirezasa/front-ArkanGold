---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="container-page py-16 max-w-2xl mx-auto text-center">
  <p class="text-xs text-gold mb-2">{eyebrow}</p>
  <h1 class="text-2xl md:text-3xl font-bold text-maroon mb-4">{title}</h1>
  <p class="text-sm leading-8 text-ink-soft">{intro}</p>
  <div class="mt-10">
    <slot />
  </div>
</section>
