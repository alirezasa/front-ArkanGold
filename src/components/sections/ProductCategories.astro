---
import Icon from '../Icon.astro';
import { loadCatalog } from '../../lib/shop';

// دسته‌بندی‌ها همان دسته‌بندی‌های فروشگاه واقعی هستند (src/lib/shop.ts) + خرید طلای آب‌شده
const { categories } = await loadCatalog();
const iconFor = { bar: 'gold-bar', gift: 'sparkle', card: 'gift-card' } as const;

const cards = [
  ...categories.map((c) => ({
    title: c.name,
    desc: c.description || 'مشاهده محصولات این دسته',
    href: `/shop?category=${encodeURIComponent(c.slug)}`,
    icon: iconFor[c.visual],
    cta: 'مشاهده محصولات',
  })),
  {
    title: 'طلای آب‌شده',
    desc: 'خرید آنلاین بدون مالیات، از ۰٫۱ گرم با قیمت لحظه‌ای',
    href: '/buy-gold',
    icon: 'gold-drop' as const,
    cta: 'خرید طلای آب‌شده',
  },
];
---

<section class="container-page py-14">
  <div class="text-center mb-10">
    <p class="text-xs font-semibold text-brand mb-2">فروشگاه آرکان گلد</p>
    <h2 class="text-2xl font-bold text-brand">دسته‌بندی محصولات طلا</h2>
    <p class="mt-2 text-base text-ink-soft max-w-xl mx-auto">
      شمش طلای ۷۵۰ عیار، شمش هدیه، کارت هدیه سازمانی و طلای آب‌شده؛ همه با قیمت لحظه‌ای.
    </p>
  </div>

  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {cards.map((c) => (
      <a href={c.href} class="group relative rounded-xl2 bg-white border border-brand-100/40 shadow-card p-6 text-center card-lift shine-hover overflow-hidden">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-brand shadow-glow transition-transform duration-300 group-hover:scale-110">
          <Icon name={c.icon} class="h-7 w-7 text-white" />
        </div>
        <h3 class="font-semibold text-brand mb-1.5 text-lg">{c.title}</h3>
        <p class="text-sm leading-6 text-ink-soft mb-3">{c.desc}</p>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-brand group-hover:gap-2 transition-all">
          {c.cta}
          <Icon name="chevron" class="h-3 w-3 rotate-90" />
        </span>
      </a>
    ))}
  </div>
</section>
