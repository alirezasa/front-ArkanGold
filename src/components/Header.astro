---
import Icon from './Icon.astro';
import { APP_URL } from '../config/site';
import { mainNav, type NavLink } from '../data/nav';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => !href.startsWith('http') && currentPath === href;
const isParentActive = (children?: NavLink[]) => !!children?.some((c) => isActive(c.href));

/** لوگوی هدر (نماد در کادر زرشکی + «آرکان گلد» زرشکی) — ?v برای به‌روزرسانی کش مرورگر پس از تغییر فایل */
const LOGO_SRC = '/images/arkan-gold-logo-header.webp?v=2';
const LOGO_W = 1124;
const LOGO_H = 356;

---

<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:right-4 focus:top-2 focus:z-50 focus:bg-brand focus:text-white focus:px-4 focus:py-2 focus:rounded">
  رفتن به محتوای اصلی
</a>

<header class="sticky top-0 z-50 border-b border-brand-100/50 bg-white/95 backdrop-blur-md supports-[backdrop-filter]:bg-white/90">
  <!-- هدر عریض: در دسکتاپ تا ۱۷۶۰ پیکسل باز می‌شود تا منو و لوگو جای کافی داشته باشند -->
  <!-- چیدمان مشابه توچال گلد: هدر تمام‌عرض، لوگو و منو کنار هم در راست، پشتیبانی و ورود در چپ -->
  <div class="header-wide flex h-16 sm:h-[68px] xl:h-16 items-center gap-3 xl:gap-8 min-[1440px]:gap-10">
    <a href="/" class="flex items-center shrink-0 group" aria-label="آرکان گلد - صفحه اصلی">
      <img
        src={LOGO_SRC}
        alt="آرکان گلد"
        width={LOGO_W}
        height={LOGO_H}
        fetchpriority="high"
        class="h-8 min-[360px]:h-9 min-[400px]:h-10 sm:h-11 xl:h-10 w-auto transition-transform duration-300 group-hover:scale-[1.03]"
      />
    </a>

    <nav aria-label="ناوبری اصلی" class="hidden xl:flex items-center gap-1 min-[1440px]:gap-3">
      {mainNav.map((item) => (
        item.children ? (
          <div class="nav-dd relative group">
            <button
              type="button"
              class:list={[
                'nav-link',
                isParentActive(item.children) || isActive(item.href) ? 'is-active' : '',
              ]}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {item.label}
              <Icon name="chevron" class="h-3.5 w-3.5 shrink-0 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" />
            </button>

            <div class="nav-dd-panel w-[25rem]">
              {item.children.map((c) => (
                <a
                  href={c.href}
                  target={c.external ? '_blank' : undefined}
                  rel={c.external ? 'noopener noreferrer' : undefined}
                  class:list={['nav-dd-link', isActive(c.href) && 'bg-canvas-100']}
                >
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand">
                    <Icon name={c.icon} class="h-5.5 w-5.5" />
                  </span>
                  <span class="flex min-w-0 flex-col">
                    <span class="text-sm font-semibold text-brand">{c.label}</span>
                    {c.desc && <span class="text-xs text-ink-soft">{c.desc}</span>}
                  </span>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.href} class:list={['nav-link', isActive(item.href) && 'is-active']}>
            {item.label}
          </a>
        )
      ))}
    </nav>

    <div class="ms-auto flex items-center gap-1 min-[360px]:gap-1.5 sm:gap-2.5 xl:gap-3 shrink-0">
      <!-- پشتیبانی آنلاین — فقط آیکون، در همه‌ی اندازه‌ها (بعد از لوگو و قبل از ورود) -->
      <button
        type="button"
        data-support-chat
        class="support-icon-btn"
        aria-label="پشتیبانی آنلاین"
        title="پشتیبانی آنلاین"
      >
        <Icon name="headset" class="h-[22px] w-[22px] sm:h-6 sm:w-6" />
      </button>

      <!-- آیتم دانلود اپلیکیشن با پاپ‌آپ QR هنگام هاور -->
      <div class="nav-download-item hidden md:inline-flex">
        <div class="nav-download-trigger" tabindex="0" role="button" aria-label="دانلود اپلیکیشن">
          <Icon name="smartphone" class="h-5 w-5 shrink-0" />
          <span class="nav-label whitespace-nowrap xl:hidden min-[1560px]:inline" aria-hidden="true">دانلود اپلیکیشن</span>
        </div>
        <div class="qr-dropdown-modal">
          <div class="qr-card">
            <div class="qr-image-wrapper">
              <img
                class="qr-image"
                src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=https://app.arkan.gold&color=330509&bgcolor=ffffff"
                alt="اسکن جهت دانلود اپلیکیشن آرکان"
                width="140"
                height="140"
                loading="lazy"
              />
            </div>
            <p class="qr-title">اسکن با دوربین موبایل</p>
            <span class="qr-subtitle">ورود مستقیم به نسخه تحت وب و اپلیکیشن</span>
            <a class="qr-direct-link" href="https://app.arkan.gold" target="_blank" rel="noopener noreferrer">
              باز کردن مستقیم لینک ↗
            </a>
          </div>
        </div>
      </div>

      <a href={APP_URL} class="btn-primary !px-2.5 min-[360px]:!px-3 min-[400px]:!px-4 sm:!px-5 !py-2 sm:!py-2.5 xl:!py-2 !shadow-[0_6px_16px_-8px_rgba(51,5,9,0.45)] text-[11px] min-[360px]:text-xs sm:text-sm whitespace-nowrap">
        ورود / ثبت نام
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="xl:hidden flex h-9 w-9 min-[360px]:h-10 min-[360px]:w-10 sm:h-11 sm:w-11 shrink-0 items-center justify-center rounded-lg border border-brand-100/60 text-brand transition-colors hover:bg-brand-50"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="باز کردن منو"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- نوار وضعیت زنده قیمت طلا — در همه‌ی سایزها از جمله موبایل نمایش داده می‌شود -->
  <div class="border-t border-brand-100/40 bg-brand text-white">
    <div class="header-wide flex min-h-[46px] sm:min-h-[52px] flex-wrap items-center justify-center gap-x-4 sm:gap-x-6 gap-y-1 py-2 text-[13px] sm:text-[15px]">
      <span class="flex items-center gap-2 whitespace-nowrap">
        <span class="live-dot shrink-0"></span>
        <span class="font-medium text-white/85"><span class="hidden sm:inline">نرخ زنده </span>طلای ۱۸ عیار<span class="hidden sm:inline"> هر گرم</span>:</span>
        <b class="tnum text-[16px] sm:text-[19px] font-extrabold text-gold-300" data-price-bind="pricePerGram" data-price-format="toman">در حال دریافت...</b>
      </span>
      <span class="tnum flex items-center gap-1.5 whitespace-nowrap">
        <span class="hidden sm:inline text-white/75">تغییر ۲۴ ساعته:</span>
        <b class="text-[14px] sm:text-[16px] font-bold" data-price-bind="changePercent" data-price-context="dark">--</b>
      </span>
      <span class="tnum whitespace-nowrap text-white/70 hidden md:inline">
        آخرین بروزرسانی: <b class="font-semibold" data-price-bind="fetchedAt">--</b>
      </span>
    </div>
  </div>
</header>

<!-- منوی موبایل تمام‌صفحه — بیرون از <header> است چون backdrop-filter هدر، position:fixed فرزندان را
     به خود هدر محدود می‌کند و منو بریده نمایش داده می‌شد -->
<div id="mobile-menu" class="fixed inset-0 z-[70] hidden xl:hidden" role="dialog" aria-modal="true" aria-label="منوی سایت">
  <!-- پس‌زمینه‌ی تیره (فقط تبلت؛ در موبایل منو تمام‌صفحه است) — کلیک روی آن منو را می‌بندد -->
  <div data-menu-backdrop class="absolute inset-0 hidden sm:block bg-brand-700/45 backdrop-blur-[2px]"></div>
  <div class="mobile-drawer relative flex h-full max-h-[100dvh] w-full sm:max-w-[440px] flex-col bg-canvas-50 sm:shadow-2xl">
    <div class="flex h-16 sm:h-[68px] items-center justify-between gap-3 border-b border-brand-100/50 bg-white px-4 sm:px-6 shrink-0">
      <a href="/" class="flex items-center" aria-label="آرکان گلد - صفحه اصلی">
        <img src={LOGO_SRC} alt="آرکان گلد" width={LOGO_W} height={LOGO_H} class="h-9 min-[360px]:h-10 sm:h-11 w-auto" />
      </a>
      <button id="mobile-menu-close" type="button" class="flex h-10 w-10 sm:h-11 sm:w-11 items-center justify-center rounded-lg border border-brand-100/60 text-brand hover:bg-brand-50" aria-label="بستن منو">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
      </button>
    </div>

    <!-- قیمت زنده بالای منوی موبایل — وسط‌چین -->
    <div class="shrink-0 bg-brand text-white px-4 py-3 text-center">
      <p class="flex items-center justify-center gap-2 text-xs text-white/80">
        <span class="live-dot"></span>
        قیمت لحظه‌ای هر گرم طلای ۱۸ عیار
      </p>
      <p class="mt-1 flex flex-wrap items-baseline justify-center gap-x-3 gap-y-0.5">
        <b class="tnum text-lg font-extrabold text-gold-300" data-price-bind="pricePerGram" data-price-format="toman">در حال دریافت...</b>
        <b class="tnum text-sm font-bold" data-price-bind="changePercent" data-price-context="dark">--</b>
      </p>
    </div>

    <nav aria-label="ناوبری موبایل" class="flex-1 overflow-y-auto overscroll-contain px-4 sm:px-6 py-4">
      <ul class="flex flex-col gap-2">
        {mainNav.map((item, idx) => (
          item.children ? (
            <li>
              <details class="m-group group/d rounded-xl border border-brand-100/40 bg-white" open={idx === 0}>
                <summary class="m-row cursor-pointer list-none">
                  <span class="m-icon"><Icon name={item.icon} class="h-5 w-5" /></span>
                  <span class="flex-1">{item.label}</span>
                  <Icon name="chevron" class="h-4 w-4 text-brand transition-transform group-open/d:rotate-180" />
                </summary>
                <div class="grid gap-1 border-t border-brand-100/30 p-2">
                  {item.children.map((c) => (
                    <a
                      href={c.href}
                      target={c.external ? '_blank' : undefined}
                      rel={c.external ? 'noopener noreferrer' : undefined}
                      class:list={['flex items-center gap-3 rounded-lg px-2.5 py-2.5 hover:bg-canvas-100', isActive(c.href) && 'bg-canvas-100']}
                    >
                      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand">
                        <Icon name={c.icon} class="h-[18px] w-[18px]" />
                      </span>
                      <span class="flex min-w-0 flex-col">
                        <span class="text-sm font-semibold text-ink">{c.label}</span>
                        {c.desc && <span class="truncate text-[11px] leading-5 text-ink-soft">{c.desc}</span>}
                      </span>
                    </a>
                  ))}
                </div>
              </details>
            </li>
          ) : (
            <li>
              <a href={item.href} class:list={['m-row rounded-xl border border-brand-100/40 bg-white', isActive(item.href) && '!border-brand/40 !text-brand']}>
                <span class="m-icon"><Icon name={item.icon} class="h-5 w-5" /></span>
                <span class="flex-1">{item.label}</span>
                <Icon name="chevron" class="h-4 w-4 rotate-90 text-ink-soft/60" />
              </a>
            </li>
          )
        ))}
        <!-- پشتیبانی آنلاین — تنها دسترسی پشتیبانی داخل منوی باز شده -->
        <li>
          <button type="button" data-support-chat class="m-row w-full rounded-xl border border-brand-100/40 bg-white text-right">
            <span class="m-icon relative">
              <Icon name="headset" class="h-5 w-5" />
              <span class="support-dot" aria-hidden="true"></span>
            </span>
            <span class="flex-1">پشتیبانی آنلاین</span>
            <span class="rounded-full bg-success-50 px-2 py-0.5 text-[11px] font-semibold text-success">آنلاین</span>
          </button>
        </li>
      </ul>

      <div class="mt-4 rounded-xl border border-brand-100/40 bg-white p-3 flex items-center gap-3">
        <img
          src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=https://app.arkan.gold&color=330509&bgcolor=ffffff"
          alt="اسکن جهت دانلود اپلیکیشن"
          width="56"
          height="56"
          class="h-14 w-14 shrink-0 rounded-lg border border-brand-100/40 bg-white"
          loading="lazy"
        />
        <div class="min-w-0">
          <p class="text-sm font-semibold text-brand">دانلود اپلیکیشن آرکان</p>
          <a href="https://app.arkan.gold" target="_blank" rel="noopener noreferrer" class="text-xs text-brand-300 font-medium">
            باز کردن مستقیم لینک ↗
          </a>
        </div>
      </div>
    </nav>

    <div class="shrink-0 border-t border-brand-100/50 bg-white px-4 sm:px-6 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
      <a href={APP_URL} class="btn-primary w-full !py-3 text-sm">ورود / ثبت نام</a>
    </div>
  </div>
</div>

<style>
  /* کانتینر عریض هدر (بزرگ‌تر از container-page صفحات) */
  .header-wide {
    margin-inline: auto;
    width: 100%;
    max-width: 2200px;
    padding-inline: 0.75rem;
  }
  @media (min-width: 360px) {
    .header-wide { padding-inline: 1rem; }
  }
  @media (min-width: 640px) {
    .header-wide { padding-inline: 1.5rem; }
  }
  @media (min-width: 1280px) {
    .header-wide { padding-inline: 1.5rem; }
  }
  @media (min-width: 1536px) {
    .header-wide { padding-inline: 2rem; }
  }

  /* ===== آیتم‌های منوی دسکتاپ ===== */
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.6rem;
    border-radius: 8px;
    font-size: 0.95rem;
    font-weight: 500;
    white-space: nowrap;
    color: #211a17;
    transition: color 0.2s;
  }
  @media (min-width: 1440px) {
    .nav-link { font-size: 1rem; }
  }
  .nav-link:hover,
  .group:hover > .nav-link,
  .group:focus-within > .nav-link {
    color: #7a171e;
  }
  .nav-link.is-active {
    color: #330509;
    font-weight: 700;
  }
  /* آیکون پشتیبانی آنلاین در هدر */
  .support-icon-btn {
    position: relative;
    display: inline-flex;
    height: 2.5rem;
    width: 2.5rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: transparent;
    color: #211a17;
    transition: background-color 0.2s, color 0.2s;
  }
  .support-icon-btn:hover {
    background: #f6e7e8;
    color: #330509;
  }
  @media (min-width: 640px) {
    .support-icon-btn { height: 2.75rem; width: 2.75rem; }
  }
  @media (max-width: 359px) {
    .support-icon-btn { height: 2.25rem; width: 2.25rem; }
  }
  .support-dot {
    position: absolute;
    top: 0.1rem;
    left: 0.1rem;
    height: 0.65rem;
    width: 0.65rem;
    border-radius: 9999px;
    border: 2px solid #fff;
    background: #1e7d4f;
  }

  .nav-dd-panel {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 60;
    margin-top: 0.5rem;
    padding: 0.5rem;
    border-radius: 16px;
    border: 1px solid rgba(230, 194, 197, 0.5);
    background: #fff;
    box-shadow: 0 20px 45px -15px rgba(51, 5, 9, 0.3);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
  }
  /* پل نامرئی بین دکمه و پنل تا با حرکت ماوس منو بسته نشود */
  .nav-dd-panel::before {
    content: '';
    position: absolute;
    inset: -0.75rem 0 auto 0;
    height: 0.75rem;
  }
  .group:hover > .nav-dd-panel,
  .group:focus-within > .nav-dd-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .nav-dd-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-radius: 12px;
    padding: 0.65rem 0.75rem;
    transition: background-color 0.2s;
  }
  .nav-dd-link:hover {
    background: #efeff1;
  }

  /* ===== منوی موبایل ===== */
  @media (min-width: 640px) {
    #mobile-menu:not(.hidden) .mobile-drawer {
      animation: drawer-in 0.25s ease-out;
    }
  }
  @keyframes drawer-in {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }
  .m-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    font-size: 0.98rem;
    font-weight: 600;
    color: #211a17;
  }
  .m-row::-webkit-details-marker {
    display: none;
  }
  .m-icon {
    display: flex;
    height: 2.4rem;
    width: 2.4rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background: #f6e7e8;
    color: #330509;
  }

  /* ===== پاپ‌آپ QR دانلود اپلیکیشن (هاور) ===== */
  .nav-download-item {
    position: relative;
    align-items: center;
    font-family: inherit;
    direction: rtl;
  }
  .nav-download-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    cursor: pointer;
    color: #5c5449;
    font-size: 0.85rem;
    font-weight: 500;
    border-radius: 10px;
    transition: all 0.2s ease;
  }
  .nav-download-trigger:hover,
  .nav-download-item:focus-within .nav-download-trigger {
    color: #330509;
    background: #f6e7e8;
  }
  .qr-dropdown-modal {
    position: absolute;
    top: 100%;
    right: 50%;
    transform: translateX(50%) translateY(10px);
    padding-top: 12px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0.25s;
    z-index: 1000;
  }
  .nav-download-item:hover .qr-dropdown-modal,
  .nav-download-item:focus-within .qr-dropdown-modal {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(50%) translateY(0);
  }
  .qr-card {
    background: #ffffff;
    color: #211a17;
    width: 220px;
    padding: 16px;
    border-radius: 14px;
    box-shadow: 0 10px 30px -5px rgba(51, 5, 9, 0.18), 0 0 0 1px rgba(51, 5, 9, 0.06);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .qr-image-wrapper {
    background: #ffffff;
    padding: 8px;
    border-radius: 10px;
    border: 1px solid #e6c2c5;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .qr-image {
    width: 140px;
    height: 140px;
    display: block;
  }
  .qr-title {
    margin: 10px 0 2px 0;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .qr-subtitle {
    font-size: 0.72rem;
    color: #64748b;
    margin-bottom: 10px;
    line-height: 1.3;
  }
  .qr-direct-link {
    font-size: 0.75rem;
    color: #7a171e;
    text-decoration: none;
    font-weight: 600;
    border-top: 1px dashed #e6c2c5;
    width: 100%;
    padding-top: 8px;
    transition: opacity 0.2s;
  }
  .qr-direct-link:hover {
    opacity: 0.7;
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('mobile-menu-close');
  const menu = document.getElementById('mobile-menu');

  function openMenu() {
    menu?.classList.remove('hidden');
    document.documentElement.style.overflow = 'hidden';
    btn?.setAttribute('aria-expanded', 'true');
    closeBtn?.focus();
  }
  function closeMenu() {
    if (menu?.classList.contains('hidden')) return;
    menu?.classList.add('hidden');
    document.documentElement.style.overflow = '';
    btn?.setAttribute('aria-expanded', 'false');
  }

  btn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  menu?.querySelector('[data-menu-backdrop]')?.addEventListener('click', closeMenu);
  // با انتخاب یک لینک یا پشتیبانی آنلاین، کلید Escape یا بزرگ شدن صفحه (نمایش منوی دسکتاپ) منو بسته می‌شود
  menu?.querySelectorAll('a, [data-support-chat]').forEach((a) => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && closeMenu());
  matchMedia('(min-width: 1280px)').addEventListener('change', (e) => e.matches && closeMenu());

  // aria-expanded منوهای کشویی دسکتاپ (هاور و فوکوس صفحه‌کلید)
  document.querySelectorAll<HTMLElement>('.nav-dd').forEach((dd) => {
    const trigger = dd.querySelector('button[aria-haspopup]');
    const set = (v: boolean) => trigger?.setAttribute('aria-expanded', String(v));
    dd.addEventListener('mouseenter', () => set(true));
    dd.addEventListener('mouseleave', () => set(dd.contains(document.activeElement)));
    dd.addEventListener('focusin', () => set(true));
    dd.addEventListener('focusout', (e) => !dd.contains(e.relatedTarget as Node) && set(false));
  });
</script>

