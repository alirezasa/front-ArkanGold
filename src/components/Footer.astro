---
import Icon from './Icon.astro';
import {
  BALE_URL,
  ENAMAD_CODE,
  ENAMAD_ID,
  INSTAGRAM_ID,
  INSTAGRAM_URL,
  MESSENGER_PHONE_FA,
  OFFICE_ADDRESS,
  OFFICE_HOURS,
  SUPPORT_HOURS,
  SUPPORT_PHONE,
  SUPPORT_PHONE_FA,
  WHATSAPP_URL,
} from '../config/site';
import { otherMenu, servicesMenu } from '../data/nav';

const enamadQuery = ENAMAD_ID && ENAMAD_CODE ? `id=${encodeURIComponent(ENAMAD_ID)}&Code=${encodeURIComponent(ENAMAD_CODE)}` : '';

type FooterLink = { label: string; href: string; external?: boolean };

/** عنوان‌ها مطابق منوی جدید سایت */
const serviceLinks: FooterLink[] = [
  ...servicesMenu.map(({ label, href }) => ({ label, href })),
  { label: 'فروش طلا', href: '/sell-gold' },
  { label: 'قیمت طلا', href: '/price' },
  { label: 'محصولات', href: '/shop' },
  { label: 'استعلام اصالت شمش', href: '/verify' },
  { label: 'مجوزها', href: '/licenses' },
];

const otherLinks: FooterLink[] = [
  ...otherMenu.map(({ label, href, external }) => ({ label, href, external })),
  { label: 'همکاری در فروش', href: '/cooperation' },
  { label: 'ورود به اپلیکیشن', href: 'https://app.arkan.gold', external: true },
];

/** شبکه‌های اجتماعی با لوگوی رنگی */
const socials = [
  { key: 'instagram', label: 'اینستاگرام', handle: INSTAGRAM_ID, href: INSTAGRAM_URL, latin: true },
  { key: 'bale', label: 'بله', handle: MESSENGER_PHONE_FA, href: BALE_URL },
  { key: 'whatsapp', label: 'واتس‌اپ', handle: MESSENGER_PHONE_FA, href: WHATSAPP_URL },
];
---

<footer class="relative mt-16 bg-brand text-white/95">
  <div class="pointer-events-none absolute inset-0 dot-grid-bg opacity-[0.05]"></div>

  <div class="container-page relative grid grid-cols-2 gap-x-6 gap-y-10 py-12 md:py-14 lg:grid-cols-[1.4fr_1fr_1fr_1.4fr]">
    <!-- ستون ۱: برند و شبکه‌های اجتماعی -->
    <div class="col-span-2 lg:col-span-1 flex flex-col items-center text-center">
      <a href="/" class="mb-5 inline-block" aria-label="آرکان گلد - صفحه اصلی">
        <img src="/images/arkan-gold-logo.png" alt="آرکان گلد" width="480" height="388" loading="lazy" class="h-24 w-auto" />
      </a>
      <p class="text-sm leading-7 text-white/80 text-justify [text-align-last:center]">
        ما در آرکان گلد تلاش کرده‌ایم تجربه‌ای مطمئن، ساده و قابل‌اتکا از معاملات طلا برای
        کاربران فراهم کنیم؛ تجربه‌ای که در آن اصالت کالا، شفافیت قیمت، امکان بررسی سفارش
        و قابلیت تحویل فیزیکی طلا در اولویت قرار دارد.
      </p>
      <p class="brand-slogan mt-4">آرکان گلد ارزش ماندگار</p>

      <ul class="mt-5 grid w-full max-w-[22rem] grid-cols-3 gap-2.5" aria-label="شبکه‌های اجتماعی آرکان گلد">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${s.label} آرکان گلد: ${s.handle}`}
              class="social-pill group"
            >
              <span class:list={['social-logo', `social-logo--${s.key}`]} aria-hidden="true">
                {s.key === 'instagram' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
                    <circle cx="12" cy="12" r="3.8" />
                    <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
                  </svg>
                )}
                {s.key === 'whatsapp' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3.6 20.4l1.3-4.4A8.6 8.6 0 1112 20.6a8.5 8.5 0 01-4.1-1.1z" />
                    <path d="M9.1 8.2c.3-.3.8-.3 1 .1l.7 1.5c.1.3 0 .6-.2.8l-.5.5c.6 1.2 1.6 2.2 2.8 2.8l.5-.5c.2-.2.5-.3.8-.2l1.5.7c.4.2.4.7.1 1-.6.7-1.4 1-2.3.8a7 7 0 01-5.2-5.2c-.2-.9.1-1.7.8-2.3z" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {s.key === 'bale' && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3.4a8.6 8.6 0 018.6 8.6 8.6 8.6 0 01-8.6 8.6H3.4V12A8.6 8.6 0 0112 3.4z" />
                    <path d="M8 11.2v1.6a1.6 1.6 0 001.6 1.6h4.8a1.6 1.6 0 001.6-1.6v-1.6" />
                    <circle cx="12" cy="16.9" r="0.9" fill="currentColor" stroke="none" />
                  </svg>
                )}
              </span>
              <span class="flex w-full min-w-0 flex-col items-center leading-tight">
                <span class="text-[11px] text-white/60">{s.label}</span>
                <span class:list={['mt-1 max-w-full truncate text-[11.5px] font-semibold text-white', s.latin ? 'font-sans' : 'tnum']} dir={s.latin ? 'ltr' : undefined}>{s.handle}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- ستون ۲: خدمات -->
    <div>
      <p class="mb-4 font-semibold text-white">خدمات و محصولات</p>
      <ul class="space-y-2.5 text-sm text-white/80">
        {serviceLinks.map((l) => (
          <li>
            <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined} class="inline-flex items-center gap-1.5 hover:text-gold transition-colors group">
              <span class="h-1 w-1 rounded-full bg-gold/0 group-hover:bg-gold transition-colors"></span>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- ستون ۳: سایر -->
    <div>
      <p class="mb-4 font-semibold text-white">سایر</p>
      <ul class="space-y-2.5 text-sm text-white/80">
        {otherLinks.map((l) => (
          <li>
            <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined} class="inline-flex items-center gap-1.5 hover:text-gold transition-colors group">
              <span class="h-1 w-1 rounded-full bg-gold/0 group-hover:bg-gold transition-colors"></span>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- ستون ۴: اطلاعات تماس و نماد اعتماد -->
    <div class="col-span-2 lg:col-span-1">
      <p class="mb-4 font-semibold text-white">ارتباط با آرکان گلد</p>
      <address class="not-italic space-y-3 text-sm text-white/85">
        <div class="flex items-start gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-gold">
            <Icon name="location" class="h-4.5 w-4.5" />
          </span>
          <div class="min-w-0">
            <p class="text-[11px] text-white/60">آدرس دفتر مرکزی</p>
            <p class="leading-7">{OFFICE_ADDRESS}</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-gold">
            <Icon name="headset" class="h-4.5 w-4.5" />
          </span>
          <div>
            <p class="text-[11px] text-white/60">شماره تماس شرکت</p>
            <a href={`tel:${SUPPORT_PHONE}`} class="font-semibold tnum hover:text-gold transition-colors">{SUPPORT_PHONE_FA}</a>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-gold">
            <Icon name="chat" class="h-4.5 w-4.5" />
          </span>
          <div>
            <p class="text-[11px] text-white/60">گفتگوی آنلاین</p>
            <button type="button" data-support-chat class="font-semibold hover:text-gold transition-colors">پشتیبانی آنلاین</button>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-gold">
            <Icon name="clock" class="h-4.5 w-4.5" />
          </span>
          <div>
            <p class="text-[11px] text-white/60">ساعات کاری دفتر</p>
            <p>{OFFICE_HOURS}</p>
            <p class="mt-0.5 text-white/70">{SUPPORT_HOURS}</p>
          </div>
        </div>
      </address>

      <!-- نماد اعتماد الکترونیکی (اینماد) -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        {enamadQuery ? (
          <a
            href={`https://trustseal.enamad.ir/?${enamadQuery}`}
            target="_blank"
            referrerpolicy="origin"
            rel="noopener"
            class="flex h-[112px] w-[96px] items-center justify-center rounded-xl bg-white p-1.5 shadow-sm"
            aria-label="نماد اعتماد الکترونیکی آرکان گلد"
          >
            <img
              referrerpolicy="origin"
              src={`https://trustseal.enamad.ir/logo.aspx?${enamadQuery}`}
              alt="نماد اعتماد الکترونیکی"
              width="84"
              height="100"
              loading="lazy"
              class="h-full w-auto object-contain cursor-pointer"
              code={ENAMAD_CODE}
            />
          </a>
        ) : (
          <a
            href="/licenses"
            class="flex h-[112px] w-[96px] flex-col items-center justify-center gap-1.5 rounded-xl bg-white p-2 text-center text-brand shadow-sm"
            aria-label="نماد اعتماد الکترونیکی آرکان گلد"
          >
            <Icon name="seal" class="h-8 w-8 text-gold" />
            <span class="text-[10px] font-semibold leading-4">نماد اعتماد الکترونیکی</span>
          </a>
        )}
        <p class="max-w-[14rem] text-xs leading-6 text-white/65">
          آرکان گلد دارای نماد اعتماد الکترونیکی از مرکز توسعه تجارت الکترونیکی است.
        </p>
      </div>
    </div>
  </div>

  <div class="relative border-t border-white/10 px-5 py-4 text-center text-xs leading-6 text-white/50">
    کلیه حقوق برای آرکان گلد (گنجینه طلای پروانه زر) محفوظ است © {new Date().getFullYear()}
  </div>
</footer>

<style>
  .social-pill {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 0.4rem 0.65rem;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    transition: transform 0.25s, border-color 0.25s, background-color 0.25s;
  }
  .social-pill:hover {
    transform: translateY(-3px);
    border-color: rgba(197, 160, 89, 0.6);
    background: rgba(255, 255, 255, 0.09);
  }
  .social-logo {
    display: flex;
    height: 2.4rem;
    width: 2.4rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    color: #fff;
    box-shadow: 0 6px 16px -8px rgba(0, 0, 0, 0.6);
  }
  .social-logo svg {
    height: 1.35rem;
    width: 1.35rem;
  }
  .social-logo--instagram {
    background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285aeb 90%);
  }
  .social-logo--whatsapp {
    background: linear-gradient(135deg, #2fe075, #128c4b);
  }
  .social-logo--bale {
    background: linear-gradient(135deg, #18b9a8, #08766c);
  }
</style>
