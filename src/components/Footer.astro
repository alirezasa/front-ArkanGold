---
const links = [
  { label: 'صفحه اصلی', href: '/' },
  { label: 'فروشگاه', href: '/shop' },
  { label: 'خرید طلای آب‌شده', href: '/buy-gold' },
  { label: 'تماس با ما', href: '/contact' },
  { label: 'درباره ما', href: '/about' },
  { label: 'قوانین و مقررات', href: '/rules' },
  { label: 'همکاری در فروش', href: '/cooperation' },
];

const socials = [
  { label: 'واتس‌اپ', href: '#' },
  { label: 'تلگرام', href: '#' },
  { label: 'یوتیوب', href: '#' },
  { label: 'توییتر', href: '#' },
  { label: 'فیسبوک', href: '#' },
];
---

<footer class="mt-16 bg-maroon text-cream-50">
  <div class="container-page grid gap-10 py-12 md:grid-cols-3">
    <div>
      <p class="text-lg font-bold">آرکان گلد</p>
      <p class="text-xs text-cream-50/60 mb-4">Arkan Gold Gallery</p>
      <p class="text-sm leading-7 text-cream-50/80">
        ما در آرکان گلد تلاش کرده‌ایم تجربه‌ای مطمئن، ساده و قابل‌اتکا از معاملات طلا برای
        کاربران فراهم کنیم؛ تجربه‌ای که در آن اصالت کالا، شفافیت قیمت، امکان بررسی سفارش
        و قابلیت تحویل فیزیکی طلا در اولویت قرار دارد.
      </p>
      <ul class="mt-5 flex gap-3">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              aria-label={s.label}
              class="flex h-9 w-9 items-center justify-center rounded-full border border-cream-50/25 text-xs hover:border-gold hover:text-gold transition-colors"
            >
              {s.label.slice(0, 1)}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="md:col-start-3">
      <p class="mb-4 font-semibold text-gold">لینک‌های مهم</p>
      <ul class="space-y-2.5 text-sm text-cream-50/80">
        {links.map((l) => (
          <li>
            <a href={l.href} class="hover:text-gold transition-colors">{l.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-cream-50/10">
    <div class="container-page flex flex-col gap-3 py-5 text-sm text-cream-50/70 md:flex-row md:items-center md:justify-between">
      <span>ساعت کاری: شنبه تا پنج‌شنبه، ۱۰ الی ۱۴ و ۱۶ الی ۲۲</span>
      <a href="tel:02198765431" class="tnum hover:text-gold">۰۲۱۹۸۷۶۵۴۳۱</a>
      <span>تهران - اختیاریه</span>
    </div>
  </div>

  <div class="border-t border-cream-50/10 py-4 text-center text-xs text-cream-50/50">
    کلیه حقوق برای آرکان گلد (گنجینه طلای پروانه زر) محفوظ است © {new Date().getFullYear()}
  </div>
</footer>
