---
import Icon from './Icon.astro';
import { ENAMAD_CODE, ENAMAD_ID, OFFICE_ADDRESS, SUPPORT_PHONE, SUPPORT_PHONE_FA } from '../config/site';

const enamadQuery = ENAMAD_ID && ENAMAD_CODE ? `id=${encodeURIComponent(ENAMAD_ID)}&Code=${encodeURIComponent(ENAMAD_CODE)}` : '';

const quickLinks = [
  { label: 'صفحه اصلی', href: '/' },
  { label: 'فروشگاه', href: '/shop' },
  { label: 'استعلام اصالت شمش', href: '/verify' },
  { label: 'خرید طلای آب‌شده', href: '/buy-gold' },
  { label: 'فروش طلا', href: '/sell-gold' },
  { label: 'قیمت لحظه‌ای', href: '/price' },
  { label: 'مجوزها و اعتبار', href: '/licenses' },
];

const supportLinks = [
  { label: 'تماس با ما', href: '/contact' },
  { label: 'درباره ما', href: '/about' },
  { label: 'سوالات متداول', href: '/faq' },
  { label: 'قوانین و مقررات', href: '/rules' },
  { label: 'همکاری در فروش', href: '/cooperation' },
  { label: 'ورود به اپلیکیشن', href: 'https://app.arkan.gold' },
];

const socials = [
  { label: 'واتس‌اپ', href: '#', icon: 'M17.5 6.5a8 8 0 10-14.6 6.5L2 21l8.2-1a8 8 0 007.3-13.5z' },
  { label: 'تلگرام', href: '#', icon: 'M21 4L2.5 11.4c-1 .4-1 1.9.1 2.2l4.6 1.4 1.7 5.4c.3.9 1.5 1.1 2.1.3l2.5-3 4.7 3.5c.8.6 1.9.1 2.1-.9L21 4z' },
  { label: 'اینستاگرام', href: '#', icon: 'M4 8a4 4 0 014-4h8a4 4 0 014 4v8a4 4 0 01-4 4H8a4 4 0 01-4-4V8z M12 9a3 3 0 100 6 3 3 0 000-6z M16.5 7.5h.01' },
];
---

<footer class="relative mt-16 bg-brand text-white/95">
  <div class="pointer-events-none absolute inset-0 dot-grid-bg opacity-[0.05]"></div>

  <div class="container-page relative grid grid-cols-2 gap-x-6 gap-y-10 py-12 md:py-14 lg:grid-cols-[1.4fr_1fr_1fr_1.4fr]">
    <!-- ستون ۱: برند و شبکه‌های اجتماعی -->
    <div class="col-span-2 lg:col-span-1">
      <div class="flex items-center gap-2.5 mb-3">
        <img src="/images/logo-mark.png" alt="آرکان گلد" width="36" height="24" class="h-8 w-auto" />
        <p class="text-lg font-bold">آرکان گلد</p>
      </div>
      <p class="text-xs text-white/55 mb-4">Arkan Gold Gallery</p>
      <p class="text-sm leading-7 text-white/80">
        ما در آرکان گلد تلاش کرده‌ایم تجربه‌ای مطمئن، ساده و قابل‌اتکا از معاملات طلا برای
        کاربران فراهم کنیم؛ تجربه‌ای که در آن اصالت کالا، شفافیت قیمت، امکان بررسی سفارش
        و قابلیت تحویل فیزیکی طلا در اولویت قرار دارد.
      </p>
      <ul class="mt-5 flex gap-3">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              aria-label={s.label}
              class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 transition-all duration-300 hover:border-gold hover:text-gold hover:-translate-y-1 hover:shadow-glow"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d={s.icon} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- ستون ۲: دسترسی سریع -->
    <div>
      <p class="mb-4 font-semibold text-white">دسترسی سریع</p>
      <ul class="space-y-2.5 text-sm text-white/80">
        {quickLinks.map((l) => (
          <li>
            <a href={l.href} class="inline-flex items-center gap-1.5 hover:text-gold transition-colors group">
              <span class="h-1 w-1 rounded-full bg-gold/0 group-hover:bg-gold transition-colors"></span>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- ستون ۳: پشتیبانی و راهنما -->
    <div>
      <p class="mb-4 font-semibold text-white">پشتیبانی و راهنما</p>
      <ul class="space-y-2.5 text-sm text-white/80">
        {supportLinks.map((l) => (
          <li>
            <a href={l.href} class="inline-flex items-center gap-1.5 hover:text-gold transition-colors group">
              <span class="h-1 w-1 rounded-full bg-gold/0 group-hover:bg-gold transition-colors"></span>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- ستون ۴: اطلاعات تماس و نماد اعتماد -->
    <div class="col-span-2 lg:col-span-1">
      <p class="mb-4 font-semibold text-white">ارتباط با آرکان گلد</p>
      <address class="not-italic space-y-3 text-sm text-white/85">
        <div class="flex items-start gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-gold">
            <Icon name="location" class="h-4.5 w-4.5" />
          </span>
          <div class="min-w-0">
            <p class="text-[11px] text-white/60">آدرس دفتر مرکزی</p>
            <p class="leading-7">{OFFICE_ADDRESS}</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-gold">
            <Icon name="headset" class="h-4.5 w-4.5" />
          </span>
          <div>
            <p class="text-[11px] text-white/60">شماره تماس شرکت</p>
            <a href={`tel:${SUPPORT_PHONE}`} class="font-semibold tnum hover:text-gold transition-colors">{SUPPORT_PHONE_FA}</a>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-gold">
            <Icon name="clock" class="h-4.5 w-4.5" />
          </span>
          <div>
            <p class="text-[11px] text-white/60">ساعت کاری</p>
            <p>شنبه تا پنج‌شنبه، ۱۰ الی ۱۴ و ۱۶ الی ۲۲</p>
          </div>
        </div>
      </address>

      <!-- نماد اعتماد الکترونیکی (اینماد) -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        {enamadQuery ? (
          <a
            href={`https://trustseal.enamad.ir/?${enamadQuery}`}
            target="_blank"
            referrerpolicy="origin"
            rel="noopener"
            class="flex h-[112px] w-[96px] items-center justify-center rounded-xl bg-white p-1.5 shadow-sm"
            aria-label="نماد اعتماد الکترونیکی آرکان گلد"
          >
            <img
              referrerpolicy="origin"
              src={`https://trustseal.enamad.ir/logo.aspx?${enamadQuery}`}
              alt="نماد اعتماد الکترونیکی"
              width="84"
              height="100"
              loading="lazy"
              class="h-full w-auto object-contain cursor-pointer"
              code={ENAMAD_CODE}
            />
          </a>
        ) : (
          <a
            href="/licenses"
            class="flex h-[112px] w-[96px] flex-col items-center justify-center gap-1.5 rounded-xl bg-white p-2 text-center text-brand shadow-sm"
            aria-label="نماد اعتماد الکترونیکی آرکان گلد"
          >
            <Icon name="seal" class="h-8 w-8 text-gold" />
            <span class="text-[10px] font-semibold leading-4">نماد اعتماد الکترونیکی</span>
          </a>
        )}
        <p class="max-w-[14rem] text-xs leading-6 text-white/65">
          آرکان گلد دارای نماد اعتماد الکترونیکی از مرکز توسعه تجارت الکترونیکی است.
        </p>
      </div>
    </div>
  </div>

  <div class="relative border-t border-white/10 px-5 py-4 text-center text-xs leading-6 text-white/50">
    کلیه حقوق برای آرکان گلد (گنجینه طلای پروانه زر) محفوظ است © {new Date().getFullYear()}
  </div>
</footer>
