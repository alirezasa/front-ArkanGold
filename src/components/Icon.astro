---
// کتابخانه‌ی آیکون‌های SVG سفارشی آرکان گلد
// استفاده: <Icon name="gold-bar" class="h-6 w-6" />
// سبک: خطی، گرد، با جزئیات طلا/جواهر و کمی حس دستی/زنده به‌جای آیکون‌های ژنریک
// مسیرهای SVG در src/lib/icons.ts هستند
import { iconPaths as paths, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
  animated?: boolean;
}

const { name, class: className = 'h-6 w-6', animated = false } = Astro.props;
---
<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={[className, animated && 'icon-draw']}
  set:html={paths[name]}
/>
