---
// کارت مطلب مجله — سه حالت:
//   card    ← کارت سفید با تصویر، دسته، عنوان، خلاصه، نویسنده و تاریخ (فهرست‌ها)
//   overlay ← تصویر تمام‌کادر با عنوان روی تصویر (بخش ویژه‌ی بالای مجله)؛ large برای کارت بزرگ
//   mini    ← ردیف افقی کوچک (ستون کناری صفحه‌ی مطلب)
// کل کارت قابل کلیک است (لینک کشیده‌ی عنوان) و لینک دسته جداگانه کار می‌کند.
import MagImage from './MagImage.astro';
import { faDate, faNum, magHref, type MagPost } from '../../lib/wp';

interface Props {
  post: MagPost;
  variant?: 'card' | 'overlay' | 'mini';
  large?: boolean;
  headingTag?: 'h2' | 'h3' | 'h4';
  eager?: boolean;
}
const { post, variant = 'card', large = false, headingTag: H = 'h3', eager = false } = Astro.props;
const href = magHref(post.path);
const cat = post.categories[0];
---

{variant === 'card' && (
  <article class="group relative flex flex-col rounded-xl2 bg-white p-3 shadow-card border border-brand-100/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-card-hover">
    <div class="relative aspect-[16/10] overflow-hidden rounded-card bg-canvas-200">
      <MagImage image={post.image} eager={eager} sizes="(min-width: 1280px) 300px, (min-width: 640px) 45vw, 100vw" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
      {cat && (
        <a href={magHref(cat.path)} class="absolute top-2.5 right-2.5 z-10 rounded-full bg-brand/90 px-2.5 py-0.5 text-[11px] font-semibold text-white backdrop-blur-sm hover:bg-brand">
          {cat.name}
        </a>
      )}
    </div>
    <div class="flex flex-1 flex-col px-1.5 pt-3.5 pb-1">
      <H class="text-[15px] font-bold leading-7 text-ink line-clamp-2 group-hover:text-brand transition-colors">
        <a href={href} class="after:absolute after:inset-0 after:content-['']">{post.title}</a>
      </H>
      <p class="mt-1.5 text-xs leading-6 text-ink-soft line-clamp-2">{post.excerpt}</p>
      <div class="mt-auto flex items-center justify-between gap-2 border-t border-dashed border-brand-100/70 pt-3 mt-3.5 text-[11px] text-ink-soft">
        <span class="flex min-w-0 items-center gap-1.5">
          {post.author?.avatar ? (
            <img src={post.author.avatar} alt="" width="22" height="22" class="h-[22px] w-[22px] shrink-0 rounded-full object-cover" loading="lazy" decoding="async" />
          ) : (
            <span class="h-[22px] w-[22px] shrink-0 rounded-full bg-brand-50"></span>
          )}
          <span class="truncate font-medium text-ink">{post.author?.name ?? 'تحریریه آرکان گلد'}</span>
        </span>
        <time datetime={post.date} class="shrink-0 tnum">{faDate(post.date)}</time>
      </div>
    </div>
  </article>
)}

{variant === 'overlay' && (
  <article class:list={['group relative h-full overflow-hidden rounded-xl2 bg-brand-700 shadow-card', large ? 'min-h-[300px] sm:min-h-[420px]' : 'min-h-[190px]']}>
    <MagImage
      image={post.image}
      eager={eager}
      sizes={large ? '(min-width: 1024px) 640px, 100vw' : '(min-width: 1024px) 320px, 50vw'}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-700/95 via-brand-700/45 to-transparent"></div>
    {cat && (
      <a href={magHref(cat.path)} class="absolute top-3 right-3 z-10 rounded-full bg-white/90 px-2.5 py-0.5 text-[11px] font-semibold text-brand backdrop-blur-sm hover:bg-white">
        {cat.name}
      </a>
    )}
    <div class:list={['absolute inset-x-0 bottom-0', large ? 'p-5 sm:p-7' : 'p-4']}>
      <H class:list={['font-bold text-white', large ? 'text-xl sm:text-2xl leading-[1.7]' : 'text-sm sm:text-[15px] leading-7 line-clamp-2']}>
        <a href={href} class="after:absolute after:inset-0 after:content-['']">{post.title}</a>
      </H>
      {large && <p class="mt-2 hidden sm:block max-w-2xl text-sm leading-7 text-white/80 line-clamp-2">{post.excerpt}</p>}
      <p class="mt-2 flex items-center gap-2 whitespace-nowrap text-[11px] text-white/70">
        <time datetime={post.date} class="tnum">{faDate(post.date)}</time>
        <span aria-hidden="true" class:list={[!large && 'hidden sm:inline']}>·</span>
        <span class:list={[!large && 'hidden sm:inline']}>{faNum(post.readingMinutes)} دقیقه مطالعه</span>
      </p>
    </div>
  </article>
)}

{variant === 'mini' && (
  <article class="group relative flex items-center gap-3">
    <div class="h-[62px] w-[84px] shrink-0 overflow-hidden rounded-lg bg-canvas-200">
      <MagImage image={post.image} sizes="84px" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" />
    </div>
    <div class="min-w-0">
      <H class="text-[13px] font-bold leading-6 text-ink line-clamp-2 group-hover:text-brand transition-colors">
        <a href={href} class="after:absolute after:inset-0 after:content-['']">{post.title}</a>
      </H>
      <time datetime={post.date} class="mt-0.5 block text-[11px] text-ink-soft tnum">{faDate(post.date)}</time>
    </div>
  </article>
)}
