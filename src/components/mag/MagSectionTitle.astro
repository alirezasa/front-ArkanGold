---
// عنوان بخش‌های مجله: «اخبار ‹طلا›» با خط‌چین تا لبه و لینک «مشاهده همه»
import Icon from '../Icon.astro';

interface Props {
  title: string;
  highlight?: string;
  href?: string;
  linkLabel?: string;
  as?: 'h2' | 'h3';
}
const { title, highlight, href, linkLabel = 'مشاهده همه', as: H = 'h2' } = Astro.props;
---

<div class="mb-6 flex items-center gap-4">
  <H class="shrink-0 text-lg md:text-xl font-bold text-brand">
    {title}
    {highlight && (
      <span class="relative mr-1 inline-block rounded-md bg-brand-50 px-2 py-0.5">
        {highlight}
        <span class="absolute -bottom-0.5 inset-x-2 h-[2px] rounded-full bg-gold" aria-hidden="true"></span>
      </span>
    )}
  </H>
  <span class="h-px flex-1 border-t border-dashed border-brand-200/70" aria-hidden="true"></span>
  {href && (
    <a href={href} class="group/link inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-brand hover:text-brand-300">
      {linkLabel}
      <Icon name="arrow-left" class="h-4 w-4 transition-transform group-hover/link:-translate-x-1" />
    </a>
  )}
</div>
