---
// کارت شمش طلا — HTML کارت از src/lib/ingotCard.ts می‌آید تا با کارت‌هایی که در
// مرورگر برای شمش‌های جدید ساخته می‌شوند یکسان باشد.
import type { GoldIngot } from '../lib/goldIngots';
import { ingotCardHtml } from '../lib/ingotCard';

interface Props {
  product: GoldIngot;
  serviceEnabled?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { product, serviceEnabled = true, headingLevel = 'h2' } = Astro.props;
---

<Fragment set:html={ingotCardHtml(product, { hasPage: true, serviceEnabled, headingTag: headingLevel })} />
