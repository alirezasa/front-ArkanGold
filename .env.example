# کپی این فایل را با نام .env بسازید و مقادیر لازم را پر کنید.
# هیچ‌کدام اجباری نیستند؛ تا وقتی خالی باشند، آن ابزار بارگذاری نمی‌شود.

# Google Analytics 4 - شناسه اندازه‌گیری (Measurement ID)
PUBLIC_GA4_ID=

# یکتانت آنالیتیکس - شناسه سایت
PUBLIC_YEKTANET_ID=

# API اصلی آرکان گلد (قیمت طلا، تاریخچه قیمت، محصولات شمش) — پیش‌فرض: https://api.arkan.gold
PUBLIC_ARKAN_API_URL=

# API استعلام اصالت شمش — پیش‌فرض: https://arkan.gold/mag/wp-json/arkan/v1/verify-bar
PUBLIC_VERIFY_API_URL=

# نماد اعتماد الکترونیکی (اینماد) — مقادیر id و Code از کد نماد در پنل enamad.ir
PUBLIC_ENAMAD_ID=
PUBLIC_ENAMAD_CODE=
