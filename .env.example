# کپی این فایل را با نام .env بسازید و مقادیر لازم را پر کنید.
# هیچ‌کدام اجباری نیستند؛ تا وقتی خالی باشند، آن ابزار بارگذاری نمی‌شود.

# Google Analytics 4 - شناسه اندازه‌گیری (Measurement ID)
PUBLIC_GA4_ID=

# یکتانت آنالیتیکس - شناسه سایت
PUBLIC_YEKTANET_ID=

# API اصلی آرکان گلد (قیمت طلا، تاریخچه قیمت، محصولات شمش) — پیش‌فرض: https://api.arkan.gold
PUBLIC_ARKAN_API_URL=

# مجله آرکان گلد (وردپرس هدلس) — آدرس REST API وردپرس، مثلا https://cms.arkan.gold/wp-json
# با پر کردن این مقدار صفحه‌های /mag روی سرور Node.js هنگام بازدید از وردپرس ساخته می‌شوند (SSR)
# و خروجی build دو بخش می‌شود: dist/client و dist/mag-app. خالی = مثل قبل (کاملاً ایستا).
PUBLIC_WP_API_URL=

# API استعلام اصالت شمش — پیش‌فرض: {PUBLIC_WP_API_URL}/arkan/v1/verify-bar
# (و اگر آن هم خالی باشد https://arkan.gold/mag/wp-json/arkan/v1/verify-bar)
PUBLIC_VERIFY_API_URL=

# نماد اعتماد الکترونیکی (اینماد) — مقادیر id و Code از کد نماد در پنل enamad.ir
PUBLIC_ENAMAD_ID=
PUBLIC_ENAMAD_CODE=

# فقط روی سرور Node.js مجله (cPanel ← Setup Node.js App ← Environment variables)، نه در build:
# MAG_REVALIDATE_TOKEN=یک رشته‌ی تصادفی حداقل ۱۶ کاراکتری؛ همان را در افزونه‌ی وردپرس وارد کنید
