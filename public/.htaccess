# تنظیمات سرور (LiteSpeed / Apache) برای خروجی ایستای سایت آرکان گلد
# این فایل در build به ریشه‌ی dist کپی می‌شود. اگر روی هاست از قبل .htaccess دارید
# (مثلا برای ریدایرکت https)، این خطوط را به همان فایل اضافه کنید.

# نوع فایل manifest برای نصب سایت به‌صورت اپلیکیشن (PWA)
AddType application/manifest+json .webmanifest

# صفحه‌ی ۴۰۴ اختصاصی سایت به‌جای صفحه‌ی پیش‌فرض سرور
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # صفحه‌ی محصول: /shop/{slug}
  # اگر صفحه‌ی ایستای این شمش وجود نداشته باشد (شمشی که بعد از آخرین build اضافه شده،
  # یا پوشه‌ای با نام فارسی که هنگام آپلود/استخراج zip خراب شده)، صفحه‌ی جزئیاتی که
  # در مرورگر از API ساخته می‌شود با همان آدرس نمایش داده می‌شود.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^shop/([^/]+)/?$ shop/item/index.html [L]

  # ---- مجله (وردپرس هدلس، /mag) ----
  # تا وقتی وردپرس هنوز در پوشه‌ی /mag همین هاست است، .htaccess خود وردپرس در آن پوشه
  # جایگزین این قوانین می‌شود و این بخش اثری ندارد.

  # آدرس‌های قدیمی RSS و sitemap وردپرس (Yoast / Rank Math) ← نسخه‌های ساخته‌شده در این پروژه
  RewriteRule ^mag/feed/?$ /mag/rss.xml [R=301,L]
  RewriteRule ^mag/(sitemap_index|[a-z_-]+-sitemap[0-9]*)\.xml$ /mag/sitemap.xml [R=301,L]

  # جست‌وجوی قدیمی وردپرس: /mag/?s=...
  RewriteCond %{QUERY_STRING} (^|&)s=
  RewriteRule ^mag/?$ /mag-live [R=302,L]

  # مطلبی که بعد از آخرین build منتشر شده و صفحه‌ی ایستا ندارد: محتوا در مرورگر از
  # REST API وردپرس با همان آدرس نمایش داده می‌شود (src/pages/mag-live.astro)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^mag/(.+)$ mag-live/index.html [L]
</IfModule>
